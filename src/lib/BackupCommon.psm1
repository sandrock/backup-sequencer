# Generated by Claude Opus 4.8 (claude.ai/code) · 2026-11-10
# Shared library for the backup sequencer: event log, projections, locking,
# window/space checks, step execution, planning, run orchestration, reporting.

Set-StrictMode -Version Latest

# --- recipe context (IoC: the engine owns it; a recipe registers its steps) -

class RecipeContext {
    [string]    $Service
    [string]    $OutDir       # dir the recipe writes into (wip for backup, stage for archive)
    [object]    $Env          # the service's / step's config env object
    [string]    $EventsPath   # sequencer event log path (read-only; archivers route by it)
    [string]    $RunId        # the run id; name archives by it so they tie back to the run
    [datetime]  $Now          # reference time (run start, or plan time for the overdue query)
    [hashtable] $State = @{}   # shared across this recipe's steps (e.g. WasRunning)
    [hashtable] $Steps = @{}   # step name -> scriptblock(param($ctx))
    [scriptblock] $OverdueBlock # optional: archiver's plan-time overdue query (param($ctx) -> double)

    [void] AddStep([string]$name, [scriptblock]$block) {
        $this.Steps[$name] = $block
    }

    # Archivers set this so the planner can ask "how overdue is this service under my
    # retention policy?" — only the archive recipe knows its periods/tiers. Returns an
    # overdue ratio: >= 1 means due, < 1 means already covered for now.
    [void] SetOverdue([scriptblock]$block) {
        $this.OverdueBlock = $block
    }

    [string] EnvValue([string]$name, [string]$fallback) {
        if ($null -ne $this.Env) {
            $prop = $this.Env.PSObject.Properties[$name]
            if ($null -ne $prop -and $null -ne $prop.Value -and "$($prop.Value)" -ne '') {
                return [string]$prop.Value
            }
        }
        return $fallback
    }

    [string] RequireEnv([string]$name) {
        $v = $this.EnvValue($name, '')
        if ($v -eq '') { throw "$name not set" }
        return $v
    }

    [object[]] ReadEvents() {
        # read-only access to the sequencer event log (for archivers that route/prune by it)
        if (-not $this.EventsPath -or -not (Test-Path -LiteralPath $this.EventsPath)) { return @() }
        $out = foreach ($line in (Get-Content -LiteralPath $this.EventsPath)) {
            if ($line.Trim()) { $line | ConvertFrom-Json }
        }
        return @($out)
    }
}

# --- time / ids -------------------------------------------------------------

function New-RunId {
    # Unpredictable-time-friendly id: sortable timestamp + random suffix.
    return (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + ('{0:x4}' -f (Get-Random -Maximum 65536))
}

function Get-NowIso {
    return (Get-Date).ToString('o')
}

# --- event log (append-only JSONL) -----------------------------------------

function Add-BackupEvent {
    param(
        [Parameter(Mandatory)][string]$EventsPath,
        [Parameter(Mandatory)][string]$Type,
        [hashtable]$Props = @{}
    )
    $dir = Split-Path -Parent $EventsPath
    if ($dir -and -not (Test-Path -LiteralPath $dir)) {
        New-Item -ItemType Directory -Force -Path $dir | Out-Null
    }
    $evt = [ordered]@{ ts = (Get-NowIso); type = $Type }
    foreach ($k in $Props.Keys) {
        $evt[$k] = $Props[$k]
    }
    Add-Content -LiteralPath $EventsPath -Value ($evt | ConvertTo-Json -Compress -Depth 20)
}

function Get-BackupEvents {
    param([Parameter(Mandatory)][string]$EventsPath)
    if (-not (Test-Path -LiteralPath $EventsPath)) {
        return @()
    }
    $events = foreach ($line in (Get-Content -LiteralPath $EventsPath)) {
        if ($line.Trim()) {
            $line | ConvertFrom-Json
        }
    }
    return @($events)
}

function Test-HasProp {
    param($Object, [string]$Name)
    return ($null -ne $Object) -and ($Object.PSObject.Properties.Name -contains $Name)
}

function Get-ServiceProjection {
    # Fold the event log into a per-service summary used by planning + status.
    param([Parameter(Mandatory)][string]$EventsPath)
    $events = Get-BackupEvents -EventsPath $EventsPath
    $projection = @{}
    foreach ($e in $events) {
        if (-not (Test-HasProp $e 'svc')) {
            continue
        }
        $svc = $e.svc
        if (-not $projection.ContainsKey($svc)) {
            $projection[$svc] = [ordered]@{
                service = $svc; lastSuccess = $null; lastStatus = $null
                lastBytes = [long]0; failCount = 0; stepDurations = @{}
            }
        }
        switch ($e.type) {
            'step.end' {
                if ((Test-HasProp $e 'durationSec') -and (Test-HasProp $e 'step')) {
                    $projection[$svc].stepDurations[$e.step] = [double]$e.durationSec
                }
            }
            'service.end' {
                $projection[$svc].lastStatus = $e.status
                if ($e.status -eq 'ok') {
                    $projection[$svc].lastSuccess = $e.ts
                    if (Test-HasProp $e 'bytes') { $projection[$svc].lastBytes = [long]$e.bytes }
                    $projection[$svc].failCount = 0
                }
                else {
                    $projection[$svc].failCount++
                }
            }
        }
    }
    return $projection
}

function Get-EstimatedServiceSeconds {
    param([Parameter(Mandatory)]$Projection, [Parameter(Mandatory)][string]$Service)
    if (-not $Projection.ContainsKey($Service)) {
        return [double]0
    }
    $sum = [double]0
    foreach ($d in $Projection[$Service].stepDurations.Values) {
        $sum += [double]$d
    }
    return $sum
}

# --- single-instance lock ---------------------------------------------------

function Enter-SequencerLock {
    param([Parameter(Mandatory)][string]$LockPath)
    if (Test-Path -LiteralPath $LockPath) {
        $lockPid = Get-Content -LiteralPath $LockPath -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($lockPid -and (Get-Process -Id ([int]$lockPid) -ErrorAction SilentlyContinue)) {
            return $false   # another live instance holds the lock
        }
        Remove-Item -LiteralPath $LockPath -Force -ErrorAction SilentlyContinue   # stale
    }
    $dir = Split-Path -Parent $LockPath
    if ($dir -and -not (Test-Path -LiteralPath $dir)) {
        New-Item -ItemType Directory -Force -Path $dir | Out-Null
    }
    Set-Content -LiteralPath $LockPath -Value $PID
    return $true
}

function Exit-SequencerLock {
    param([Parameter(Mandatory)][string]$LockPath)
    Remove-Item -LiteralPath $LockPath -Force -ErrorAction SilentlyContinue
}

# --- window / space ---------------------------------------------------------

function Test-WithinWindow {
    param(
        [Parameter(Mandatory)][string]$Open,
        [Parameter(Mandatory)][string]$Close,
        [datetime]$Now = (Get-Date)
    )
    $openTime = [datetime]::ParseExact($Open, 'HH:mm', $null).TimeOfDay
    $closeTime = [datetime]::ParseExact($Close, 'HH:mm', $null).TimeOfDay
    $nowTime = $Now.TimeOfDay
    if ($openTime -le $closeTime) {
        return ($nowTime -ge $openTime -and $nowTime -lt $closeTime)
    }
    # window wraps past midnight (e.g. 23:00 -> 06:00)
    return ($nowTime -ge $openTime -or $nowTime -lt $closeTime)
}

function Get-WindowLengthSeconds {
    # Total length of the window, handling the past-midnight wrap.
    param([Parameter(Mandatory)][string]$Open, [Parameter(Mandatory)][string]$Close)
    $openTime = [datetime]::ParseExact($Open, 'HH:mm', $null).TimeOfDay
    $closeTime = [datetime]::ParseExact($Close, 'HH:mm', $null).TimeOfDay
    $lengthSeconds = ($closeTime - $openTime).TotalSeconds
    if ($lengthSeconds -le 0) { $lengthSeconds += 86400 }   # wraps past midnight
    return $lengthSeconds
}

function Get-SecondsUntilClose {
    # Seconds from Now until the next occurrence of the close time.
    param([Parameter(Mandatory)][string]$Close, [datetime]$Now = (Get-Date))
    $closeTime = [datetime]::ParseExact($Close, 'HH:mm', $null).TimeOfDay
    $nextClose = $Now.Date.Add($closeTime)
    if ($nextClose -le $Now) { $nextClose = $nextClose.AddDays(1) }
    return ($nextClose - $Now).TotalSeconds
}

function Get-FreeSpaceBytes {
    param([Parameter(Mandatory)][string]$Path)
    $full = $Path
    while ($full -and -not (Test-Path -LiteralPath $full)) {
        $full = Split-Path -Parent $full
    }
    if (-not $full) {
        $full = (Get-Location).Path
    }
    $best = $null
    foreach ($d in [System.IO.DriveInfo]::GetDrives()) {
        if (-not $d.IsReady) { continue }
        $root = $d.RootDirectory.FullName
        if ($full.StartsWith($root)) {
            if ($null -eq $best -or $root.Length -gt $best.RootDirectory.FullName.Length) {
                $best = $d
            }
        }
    }
    if ($best) {
        return [long]$best.AvailableFreeSpace
    }
    return [long]::MaxValue
}

function Get-PathSizeBytes {
    param([Parameter(Mandatory)][string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) {
        return [long]0
    }
    # Sum lengths directly. Avoid `(... | Measure-Object -Sum).Sum`: with zero
    # files the subexpression is $null, and $null.Sum throws under StrictMode
    # (the empty-dir crash after a cleanup/wipe step).
    $files = @(Get-ChildItem -LiteralPath $Path -Recurse -File -ErrorAction SilentlyContinue)
    $total = [long]0
    foreach ($f in $files) {
        $total += [long]$f.Length
    }
    return $total
}

# --- step execution ---------------------------------------------------------

function Invoke-BackupStep {
    # Run one step inline with timing + retries, emitting step.start / step.end.
    # (Hard timeout enforcement is a later iteration; timeoutSec is recorded only.)
    param(
        [Parameter(Mandatory)][string]$EventsPath,
        [Parameter(Mandatory)][string]$RunId,
        [Parameter(Mandatory)][string]$Service,
        [Parameter(Mandatory)][string]$Step,
        [Parameter(Mandatory)][scriptblock]$Action,
        [int]$Retries = 0,
        [int]$BackoffSec = 5
    )
    $attempt = 0
    while ($true) {
        Add-BackupEvent -EventsPath $EventsPath -Type 'step.start' `
            -Props @{ runId = $RunId; svc = $Service; step = $Step; attempt = $attempt }
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $status = 'ok'
        $errMsg = $null
        try {
            & $Action | Out-Null
        }
        catch {
            $status = 'fail'
            $errMsg = $_.Exception.Message
        }
        $sw.Stop()
        $props = @{
            runId = $RunId; svc = $Service; step = $Step; status = $status
            durationSec = [math]::Round($sw.Elapsed.TotalSeconds, 2); attempt = $attempt
        }
        if ($errMsg) { $props.error = $errMsg }
        Add-BackupEvent -EventsPath $EventsPath -Type 'step.end' -Props $props
        if ($status -eq 'ok') {
            return 'ok'
        }
        if ($attempt -ge $Retries) {
            return 'fail'
        }
        Start-Sleep -Seconds $BackoffSec
        $attempt++
    }
}

# --- planning ---------------------------------------------------------------

function Get-MergedArchiveEnv {
    # top-level config.archive defaults, overridden by the service's syncArchive.env
    param([Parameter(Mandatory)]$Config, $SyncArchive)
    $envMap = [ordered]@{}
    if ((Test-HasProp $Config 'archive') -and ($null -ne $Config.archive)) {
        foreach ($prop in @($Config.archive.PSObject.Properties)) { $envMap[$prop.Name] = $prop.Value }
    }
    if ($SyncArchive -and (Test-HasProp $SyncArchive 'env') -and ($null -ne $SyncArchive.env)) {
        foreach ($prop in @($SyncArchive.env.PSObject.Properties)) { $envMap[$prop.Name] = $prop.Value }
    }
    return [pscustomobject]$envMap
}

function Get-ServiceOverdue {
    # Ask a service's archive recipe how overdue it is (plan time). Only the archiver
    # knows its retention periods / cross-tier coverage. Returns $null if the service
    # has no archiver or its recipe registers no overdue query.
    param(
        [Parameter(Mandatory)]$Config,
        [Parameter(Mandatory)][string]$Service,
        [Parameter(Mandatory)][string]$BaseDir,
        [Parameter(Mandatory)][string]$EventsPath,
        [datetime]$At = (Get-Date)
    )
    $serviceConfig = $Config.services.$Service
    if (-not (Test-HasProp $serviceConfig 'syncArchive')) { return $null }
    $syncArchive = $serviceConfig.syncArchive
    $scriptPath = Join-Path $BaseDir $syncArchive.script
    if (-not (Test-Path -LiteralPath $scriptPath)) { return $null }
    $arc = [RecipeContext]::new()
    $arc.Service = $Service
    $arc.EventsPath = $EventsPath
    $arc.Now = $At
    $arc.Env = Get-MergedArchiveEnv -Config $Config -SyncArchive $syncArchive
    & $scriptPath -Recipe $arc | Out-Null     # registration only
    if ($null -eq $arc.OverdueBlock) { return $null }
    try { return [double](& $arc.OverdueBlock $arc) } catch { return $null }
}

function Get-BackupPlan {
    # Pure: (config, projection, now) -> ALL enabled services, score-sorted.
    # Fluid scheduling — score = overdue + sizeNudge:
    #   overdue   = age / target        (how overdue vs the desired interval;
    #                                    never-run floats to the top for a baseline)
    #   sizeNudge = est / windowLength  (biggest-first tie-break + head start for big
    #                                    jobs, which need the most room to fit)
    # age dominates (whole-interval units) so rotation is fair; size only nudges ties.
    # Mandatory services are forced to the front (still score-ordered among themselves).
    # target = <service>.targetIntervalHours, else <config>.targetIntervalHours, else 24h.
    # OverdueByService: archiver-computed overdue per service (from Get-ServiceOverdue);
    # overrides the generic age/target when present (the archiver knows its coverage).
    param(
        [Parameter(Mandatory)]$Config,
        $Projection = @{},
        [datetime]$At = (Get-Date),
        [hashtable]$OverdueByService = @{}
    )
    $windowSeconds = Get-WindowLengthSeconds -Open $Config.window.open -Close $Config.window.close
    $defaultTargetHours = 24.0
    if (Test-HasProp $Config 'targetIntervalHours') { $defaultTargetHours = [double]$Config.targetIntervalHours }

    $entries = @()
    foreach ($serviceName in $Config.services.PSObject.Properties.Name) {
        $serviceConfig = $Config.services.$serviceName
        $enabled = (Test-HasProp $serviceConfig 'enabled') -and [bool]$serviceConfig.enabled
        if (-not $enabled) { continue }
        $isMandatory = (Test-HasProp $serviceConfig 'mandatory') -and [bool]$serviceConfig.mandatory
        $estimatedSeconds = Get-EstimatedServiceSeconds -Projection $Projection -Service $serviceName
        $lastSuccess = $null
        if ($Projection.ContainsKey($serviceName)) { $lastSuccess = $Projection[$serviceName].lastSuccess }

        $targetHours = $defaultTargetHours
        if (Test-HasProp $serviceConfig 'targetIntervalHours') { $targetHours = [double]$serviceConfig.targetIntervalHours }
        $targetSeconds = [math]::Max(1.0, $targetHours * 3600.0)

        if ($lastSuccess) {
            $ageSeconds = ($At - [datetime]$lastSuccess).TotalSeconds
            if ($ageSeconds -lt 0) { $ageSeconds = 0 }
        }
        else {
            $ageSeconds = -1.0        # never run
        }
        # overdue: the archiver's judgement if it gave one (it knows coverage), else
        # the generic age/target (never-run floats to the top for a first baseline).
        if ($OverdueByService.ContainsKey($serviceName)) {
            $overdue = [double]$OverdueByService[$serviceName]
        }
        elseif ($lastSuccess) {
            $overdue = $ageSeconds / $targetSeconds
        }
        else {
            $overdue = 1e6
        }
        $sizeNudge = if ($windowSeconds -gt 0) { $estimatedSeconds / $windowSeconds } else { 0 }

        $entries += [pscustomobject]@{
            Service          = $serviceName
            Mandatory        = $isMandatory
            EstimatedSeconds = $estimatedSeconds
            LastSuccess      = $lastSuccess
            AgeSeconds       = $ageSeconds
            Overdue          = $overdue
            Score            = $overdue + $sizeNudge
        }
    }
    $mandatoryJobs = @($entries | Where-Object { $_.Mandatory } | Sort-Object -Property Score -Descending -Stable)
    $otherJobs = @($entries | Where-Object { -not $_.Mandatory } | Sort-Object -Property Score -Descending -Stable)
    return @($mandatoryJobs + $otherJobs)
}

# --- spool phases (wip -> stage -> ready, trash) ----------------------------

function Get-SpoolPaths {
    param([Parameter(Mandatory)][string]$SpoolRoot)
    return @{
        Wip   = Join-Path $SpoolRoot 'wip'
        Stage = Join-Path $SpoolRoot 'stage'
        Ready = Join-Path $SpoolRoot 'ready'
        Trash = Join-Path $SpoolRoot 'trash'
    }
}

function Move-ToTrash {
    # Atomic rename of a dir into trash/ (instant); the reaper frees it later.
    param([Parameter(Mandatory)][string]$Path, [Parameter(Mandatory)][string]$TrashRoot)
    if (-not (Test-Path -LiteralPath $Path)) { return }
    if (-not (Test-Path -LiteralPath $TrashRoot)) {
        New-Item -ItemType Directory -Force -Path $TrashRoot | Out-Null
    }
    $name = (Split-Path -Leaf $Path) + '-' + ([guid]::NewGuid().ToString('n').Substring(0, 12))
    [System.IO.Directory]::Move($Path, (Join-Path $TrashRoot $name))
}

function Move-Phase {
    # Atomic rename of a backup dir from one phase to the next (same filesystem).
    param([Parameter(Mandatory)][string]$Src, [Parameter(Mandatory)][string]$Dst)
    $parent = Split-Path -Parent $Dst
    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
        New-Item -ItemType Directory -Force -Path $parent | Out-Null
    }
    [System.IO.Directory]::Move($Src, $Dst)
}

function Clear-Trash {
    # Reaper: free everything already moved to trash/. Off the publish hot path.
    param([Parameter(Mandatory)][string]$TrashRoot)
    if (-not (Test-Path -LiteralPath $TrashRoot)) { return }
    foreach ($item in (Get-ChildItem -LiteralPath $TrashRoot -Force -ErrorAction SilentlyContinue)) {
        Remove-Item -LiteralPath $item.FullName -Recurse -Force -ErrorAction SilentlyContinue
    }
}

# --- run orchestration ------------------------------------------------------

function Invoke-BackupRun {
    # Narration goes to the Information stream (progress) and Warning stream
    # (notable events). Callers choose visibility via -InformationAction /
    # -WarningAction; recipes inherit the same streams.
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]$Config,
        [Parameter(Mandatory)][hashtable]$Paths,   # BaseDir, EventsPath, LockPath, SpoolRoot
        [switch]$ForceWindow,                      # run even when outside the window
        [switch]$ForceAllJobs                      # skip the fit check: attempt every job (no deferral)
    )
    if (-not (Enter-SequencerLock -LockPath $Paths.LockPath)) {
        Write-Warning 'sequencer already running; exiting.'
        return
    }
    try {
        $runId = New-RunId
        $stg = Get-SpoolPaths -SpoolRoot $Paths.SpoolRoot
        foreach ($d in @($stg.Wip, $stg.Stage, $stg.Ready, $stg.Trash)) {
            if (-not (Test-Path -LiteralPath $d)) { New-Item -ItemType Directory -Force -Path $d | Out-Null }
        }
        Clear-Trash -TrashRoot $stg.Trash   # reap leftovers at run start, off the publish path

        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'run.start' `
            -Props @{ runId = $runId; window = "$($Config.window.open)-$($Config.window.close)" }
        Write-Information ("Backup run {0}  (window {1}-{2})" -f $runId, $Config.window.open, $Config.window.close)

        $projection = Get-ServiceProjection -EventsPath $Paths.EventsPath
        # ask each service's archiver how overdue it is (it knows its own coverage)
        $planNow = Get-Date
        $overdueByService = @{}
        foreach ($name in $Config.services.PSObject.Properties.Name) {
            if (-not ((Test-HasProp $Config.services.$name 'enabled') -and [bool]$Config.services.$name.enabled)) { continue }
            $od = Get-ServiceOverdue -Config $Config -Service $name -BaseDir $Paths.BaseDir -EventsPath $Paths.EventsPath -At $planNow
            if ($null -ne $od) { $overdueByService[$name] = $od }
        }
        $plan = Get-BackupPlan -Config $Config -Projection $projection -At $planNow -OverdueByService $overdueByService
        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'run.plan' `
            -Props @{ runId = $runId; plan = @($plan.Service) }

        $okCount = 0
        $failCount = 0
        $ranGuaranteed = $false   # has a non-mandatory job started this run? (fluid: >=1 per window)
        foreach ($plannedJob in $plan) {
            # hard window gate: never START work past close (a running job may overrun)
            if (-not $ForceWindow -and -not (Test-WithinWindow -Open $Config.window.open -Close $Config.window.close)) {
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'run.windowclosed' -Props @{ runId = $runId }
                if (($okCount + $failCount) -gt 0) {
                    Write-Information ("Backup window closed ({0}-{1}); remaining services deferred to the next run." -f $Config.window.open, $Config.window.close)
                }
                else {
                    Write-Information ("Outside the backup window ({0}-{1}); nothing run. Use -ForceWindow to override." -f $Config.window.open, $Config.window.close)
                }
                break
            }
            $serviceName = $plannedJob.Service

            # coverage gate: skip a service already backed up for its period (the
            # archiver judged overdue < 1 — e.g. a yearly/weekly also covers the daily).
            # No backup produced, so no wasted downtime. -ForceAllJobs overrides.
            if (-not $ForceAllJobs -and $plannedJob.Overdue -lt 1) {
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.skip' `
                    -Props @{ runId = $runId; svc = $serviceName; reason = 'covered'; overdue = [math]::Round([double]$plannedJob.Overdue, 3) }
                Write-Information ("  {0}  covered (overdue x{1:N2}) - skipped" -f $serviceName, $plannedJob.Overdue)
                continue
            }

            # fluid fit decision: start a service only if its estimate fits the time
            # left before close. Exceptions that still run: an unknown estimate
            # (first-ever, optimistic) and the FIRST non-mandatory job of the run
            # (guaranteed progress — lets an over-window job take a solo night when it
            # is the most overdue). Mandatory and -ForceAllJobs bypass the check.
            if (-not $ForceAllJobs -and -not $plannedJob.Mandatory) {
                $estimatedSeconds = [double]$plannedJob.EstimatedSeconds
                $remainingSeconds = Get-SecondsUntilClose -Close $Config.window.close
                $fitsInWindow = ($estimatedSeconds -le 0) -or ($estimatedSeconds -le $remainingSeconds)
                if (-not $fitsInWindow -and $ranGuaranteed) {
                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.skip' `
                        -Props @{ runId = $runId; svc = $serviceName; reason = 'deferred'; estSec = [int]$estimatedSeconds; remainingSec = [int]$remainingSeconds }
                    Write-Information ("  {0}  deferred (est {1}s, {2}s left in window)" -f $serviceName, [int]$estimatedSeconds, [int]$remainingSeconds)
                    continue
                }
                $ranGuaranteed = $true
            }

            $wipDir = Join-Path $stg.Wip $serviceName
            $stageDir = Join-Path $stg.Stage $serviceName
            $readyDir = Join-Path $stg.Ready $serviceName
            try {
            # isolate per-service failures: an unhandled error here fails only this service
            $svc = $Config.services.$serviceName
            $scriptPath = Join-Path $Paths.BaseDir $svc.script

            # pre-flight free-space check against the last recorded size (1.5x headroom)
            if ($projection.ContainsKey($serviceName) -and $projection[$serviceName].lastBytes -gt 0) {
                $need = [long]($projection[$serviceName].lastBytes * 1.5)
                $free = Get-FreeSpaceBytes -Path $Paths.SpoolRoot
                if ($free -lt $need) {
                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.skip' `
                        -Props @{ runId = $runId; svc = $serviceName; reason = 'insufficient-space'; needBytes = $need; freeBytes = $free }
                    Write-Warning "$serviceName skipped: insufficient space (need $need, free $free)"
                    continue
                }
            }

            # fresh wip dir (clear any leftover from a prior crash)
            Move-ToTrash -Path $wipDir -TrashRoot $stg.Trash
            New-Item -ItemType Directory -Force -Path $wipDir | Out-Null

            # --- load the recipe (it registers its steps) and produce into wip/<service> ---
            $rc = [RecipeContext]::new()
            $rc.Service = $serviceName
            $rc.OutDir = $wipDir
            $rc.Env = if (Test-HasProp $svc 'env') { $svc.env } else { $null }
            $rc.EventsPath = $Paths.EventsPath
            $rc.RunId = $runId
            & $scriptPath -Recipe $rc | Out-Null   # registration only; don't let output taint the run

            $failed = $false
            foreach ($stepDef in $svc.steps) {
                $stepName = $stepDef.name
                $always = (Test-HasProp $stepDef 'alwaysRun') -and $stepDef.alwaysRun
                if ($failed -and -not $always) {
                    continue   # skip normal steps after a failure, but still run recovery (e.g. start)
                }
                $retries = 0
                if (Test-HasProp $stepDef 'retries') { $retries = [int]$stepDef.retries }
                if ($rc.Steps.ContainsKey($stepName)) {
                    $stepBlock = $rc.Steps[$stepName]
                    $action = { & $stepBlock $rc }.GetNewClosure()
                }
                else {
                    $missing = $stepName
                    $action = { throw "recipe did not register step '$missing'" }.GetNewClosure()
                }
                $r = Invoke-BackupStep -EventsPath $Paths.EventsPath -RunId $runId `
                    -Service $serviceName -Step $stepName -Action $action -Retries $retries
                if ($r -ne 'ok' -and -not $always) { $failed = $true }
            }

            if ($failed) {
                Move-ToTrash -Path $wipDir -TrashRoot $stg.Trash   # discard the partial dump
                $failCount++
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.end' `
                    -Props @{ runId = $runId; svc = $serviceName; status = 'fail'; bytes = 0 }
                Write-Warning "$serviceName FAILED: partial dump discarded"
                continue
            }

            $bytes = Get-PathSizeBytes -Path $wipDir

            # --- promote wip -> stage ---
            Move-ToTrash -Path $stageDir -TrashRoot $stg.Trash   # clear any leftover
            Move-Phase -Src $wipDir -Dst $stageDir

            # --- optional synchronous archive step, on stage/<service> ---
            $syncFailed = $false
            if (Test-HasProp $svc 'syncArchive') {
                $sa = $svc.syncArchive
                $saScript = Join-Path $Paths.BaseDir $sa.script
                if (-not (Test-Path -LiteralPath $saScript)) {
                    $syncFailed = $true
                    $reason = "recipe not found: $($sa.script)"
                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.syncfail' `
                        -Props @{ runId = $runId; svc = $serviceName; reason = $reason }
                    Write-Warning "$serviceName sync-archive skipped: $reason (backup still published)"
                }
                else {
                    $arc = [RecipeContext]::new()
                    $arc.Service = $serviceName
                    $arc.OutDir = $stageDir
                    $arc.EventsPath = $Paths.EventsPath
                    $arc.RunId = $runId
                    # archive env: top-level config.archive defaults, overridden per-service
                    $archiveEnv = [ordered]@{}
                    if ((Test-HasProp $Config 'archive') -and ($null -ne $Config.archive)) {
                        foreach ($prop in @($Config.archive.PSObject.Properties)) { $archiveEnv[$prop.Name] = $prop.Value }
                    }
                    if ((Test-HasProp $sa 'env') -and ($null -ne $sa.env)) {
                        foreach ($prop in @($sa.env.PSObject.Properties)) { $archiveEnv[$prop.Name] = $prop.Value }
                    }
                    $arc.Env = [pscustomobject]$archiveEnv
                    & $saScript -Recipe $arc | Out-Null
                    if (-not $arc.Steps.ContainsKey('archive')) {
                        $syncFailed = $true
                        $reason = "recipe did not register an 'archive' step"
                        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.syncfail' `
                            -Props @{ runId = $runId; svc = $serviceName; reason = $reason }
                        Write-Warning "$serviceName sync-archive FAILED: $reason (backup still published)"
                    }
                    else {
                        $archiveBlock = $arc.Steps['archive']
                        $saAction = { & $archiveBlock $arc }.GetNewClosure()
                        $rsa = Invoke-BackupStep -EventsPath $Paths.EventsPath -RunId $runId `
                            -Service $serviceName -Step 'sync-archive' -Action $saAction
                        $syncFailed = ($rsa -ne 'ok')
                        if ($syncFailed) {
                            $reason = (Get-BackupEvents -EventsPath $Paths.EventsPath |
                                Where-Object { $_.type -eq 'step.end' -and $_.svc -eq $serviceName -and $_.step -eq 'sync-archive' -and $_.status -eq 'fail' } |
                                Select-Object -Last 1).error
                            if (-not $reason) { $reason = 'see events.jsonl' }
                            Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.syncfail' `
                                -Props @{ runId = $runId; svc = $serviceName; reason = $reason }
                            Write-Warning "$serviceName sync-archive FAILED: $reason (backup still published)"
                        }
                        else {
                            # record the archive in the sequencer log (reported by the recipe)
                            $res = if ($arc.State.ContainsKey('Result')) { $arc.State['Result'] } else { @{} }
                            $props = @{ runId = $runId; svc = $serviceName }
                            if ($res -is [hashtable]) {
                                if ($res.ContainsKey('tier') -and $res['tier']) { $props['tier'] = $res['tier'] }
                                if ($res.ContainsKey('path') -and $res['path']) { $props['path'] = $res['path'] }
                            }
                            Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.archived' -Props $props
                            # record any archives the recipe pruned (log-driven retention)
                            $prunedCount = 0
                            if (($res -is [hashtable]) -and $res.ContainsKey('pruned') -and $res['pruned']) {
                                foreach ($pp in @($res['pruned'])) {
                                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.archive-pruned' `
                                        -Props @{ runId = $runId; svc = $serviceName; path = $pp }
                                }
                                $prunedCount = @($res['pruned']).Count
                            }
                            $archMsg = "  $serviceName  archived"
                            if ($props.ContainsKey('path')) { $archMsg += " -> $($props['path'])" }
                            if ($prunedCount -gt 0) { $archMsg += "  (pruned $prunedCount)" }
                            Write-Information $archMsg
                        }
                    }
                }
            }

            # --- publish stage -> ready (or discard if sync-only and sync ok) ---
            $publishToReady = $true
            if (Test-HasProp $svc 'publishToReady') { $publishToReady = [bool]$svc.publishToReady }
            if ($syncFailed) { $publishToReady = $true }   # never lose a backup on sync failure

            if ($publishToReady) {
                if (Test-Path -LiteralPath $readyDir) {
                    # previous backup never taken by the archiver: replace + notify
                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.replaced' `
                        -Props @{ runId = $runId; svc = $serviceName; reason = 'previous-unarchived' }
                    Move-ToTrash -Path $readyDir -TrashRoot $stg.Trash
                    Write-Warning "$serviceName replaced previous un-archived backup (archiver behind)"
                }
                Move-Phase -Src $stageDir -Dst $readyDir
            }
            else {
                Move-ToTrash -Path $stageDir -TrashRoot $stg.Trash   # archived synchronously; drop local copy
            }

            $okCount++
            Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.end' `
                -Props @{ runId = $runId; svc = $serviceName; status = 'ok'; bytes = $bytes }
            $mb = [math]::Round(($bytes / 1MB), 1)
            $dest = if ($publishToReady) { "ready/$serviceName" } else { 'archived (sync); local copy dropped' }
            Write-Information ("  {0}  OK  ({1} MB)  -> {2}" -f $serviceName, $mb, $dest)
            }
            catch {
                $emsg = $_.Exception.Message
                $failCount++
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.end' `
                    -Props @{ runId = $runId; svc = $serviceName; status = 'fail'; bytes = 0; error = $emsg }
                Write-Warning "$serviceName FAILED: $emsg"
                try { Move-ToTrash -Path $wipDir -TrashRoot $stg.Trash; Move-ToTrash -Path $stageDir -TrashRoot $stg.Trash } catch { }
            }
        }

        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'run.end' `
            -Props @{ runId = $runId; summary = @{ ok = $okCount; failed = $failCount; planned = $plan.Count } }
        Write-Information ("  -- ok={0} failed={1} planned={2}" -f $okCount, $failCount, $plan.Count)
        return $runId
    }
    finally {
        Exit-SequencerLock -LockPath $Paths.LockPath
    }
}

# --- reporting --------------------------------------------------------------

function Format-RunReport {
    # Render a terse text report for one run (reused by history + notifications).
    param(
        [Parameter(Mandatory)][string]$EventsPath,
        [Parameter(Mandatory)][string]$RunId
    )
    $events = Get-BackupEvents -EventsPath $EventsPath | Where-Object { (Test-HasProp $_ 'runId') -and $_.runId -eq $RunId }
    $lines = @("Backup run $RunId")
    foreach ($e in ($events | Where-Object { $_.type -eq 'service.end' })) {
        $mb = [math]::Round(($e.bytes / 1MB), 1)
        $lines += ("  {0,-24} {1,-5} {2} MB" -f $e.svc, $e.status.ToUpper(), $mb)
    }
    $end = $events | Where-Object { $_.type -eq 'run.end' } | Select-Object -First 1
    if ($end) {
        $lines += ("  -- ok={0} failed={1} planned={2}" -f $end.summary.ok, $end.summary.failed, $end.summary.planned)
    }
    return ($lines -join "`n")
}

function Send-BackupReport {
    # Send a run report via swaks over SMTP. Keep the body terse (no secrets).
    param(
        [Parameter(Mandatory)]$Notify,     # config.notify object
        [Parameter(Mandatory)][string]$Subject,
        [Parameter(Mandatory)][string]$Body,
        [string]$BaseDir = '.'
    )
    if (-not $Notify.enabled) {
        return $false
    }
    if (-not (Get-Command swaks -ErrorAction SilentlyContinue)) {
        Write-Warning 'swaks not found; skipping email report.'
        return $false
    }
    $passFile = Join-Path $BaseDir $Notify.passwordFile
    if (-not (Test-Path -LiteralPath $passFile)) {
        Write-Warning "SMTP password file not found: $passFile; skipping email."
        return $false
    }
    $pass = (Get-Content -LiteralPath $passFile -Raw).Trim()
    $tmp = New-TemporaryFile
    Set-Content -LiteralPath $tmp -Value $Body
    try {
        foreach ($to in $Notify.to) {
            & swaks --to $to --from $Notify.from `
                --server $Notify.server --auth-user $Notify.authUser --auth-password $pass `
                --header "Subject: $Subject" --body $tmp | Out-Null
        }
    }
    finally {
        Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
    }
    return $true
}

