# Shared library for the backup sequencer: event log, projections, locking,
# window/space checks, step execution, planning, run orchestration, reporting.

Set-StrictMode -Version Latest

# --- event log lines --------------------------------------------------------

class EventLog {
    # One event line -> object, with `ts` as an exact UTC [datetime]. ConvertFrom-Json
    # turns ISO strings into local-kind dates and drops the offset, so differences
    # across a DST change come out an hour wrong; the raw string is parsed instead.
    # Accepts both old local-with-offset stamps and UTC `Z` ones.
    static [object] ParseLine([string]$Line) {
        $e = $Line | ConvertFrom-Json
        $m = [regex]::Match($Line, '"ts"\s*:\s*"([^"]+)"')
        if ($m.Success -and $e.PSObject.Properties['ts']) {
            $e.ts = [System.DateTimeOffset]::Parse($m.Groups[1].Value, [System.Globalization.CultureInfo]::InvariantCulture).UtcDateTime
        }
        return $e
    }
}

# --- disk usage ---------------------------------------------------------------

class DiskUsage {
    # Size and file count of a tree, measured before deleting it so a deletion can
    # be logged with what it freed. Missing path -> 0/0. Hidden files included.
    static [hashtable] Measure([string]$Path) {
        $r = @{ Bytes = [long]0; Files = 0 }
        if (-not (Test-Path -LiteralPath $Path)) { return $r }
        $item = Get-Item -LiteralPath $Path -Force
        $files = if ($item.PSIsContainer) { @(Get-ChildItem -LiteralPath $Path -Recurse -File -Force -ErrorAction SilentlyContinue) } else { @($item) }
        foreach ($f in $files) { $r.Bytes += [long]$f.Length; $r.Files++ }
        return $r
    }

    # compact, culture-independent byte size: 812 KB, 7.2 MB, 52.4 GB
    static [string] Text([double]$Bytes) {
        $inv = [System.Globalization.CultureInfo]::InvariantCulture
        if ($Bytes -ge 1GB) { return [string]::Format($inv, '{0:0.0} GB', $Bytes / 1GB) }
        if ($Bytes -ge 1MB) { return [string]::Format($inv, '{0:0.0} MB', $Bytes / 1MB) }
        return [string]::Format($inv, '{0:0} KB', $Bytes / 1KB)
    }
}

# --- recipe context (IoC: the engine owns it; a recipe registers its steps) -

class RecipeContext {
    [string]    $Service
    [string]    $OutDir       # dir the recipe writes into (wip for backup, stage for archive)
    [object]    $Env          # the service's / step's config env object
    [string]    $EventsPath   # sequencer event log path (read-only; archivers route by it)
    [string]    $RunId        # the run id; name archives by it so they tie back to the run
    [datetime]  $Now          # reference time (run start)
    [hashtable] $State = @{}   # shared across this recipe's steps (e.g. WasRunning)
    [hashtable] $Steps = @{}   # step name -> scriptblock(param($ctx))
    [string[]]  $ConfiguredSteps = @()  # step names the service config lists (run order); lets a recipe adapt/validate
    [scriptblock] $OverdueBlock # unused for now, see SetOverdue
    [scriptblock] $ValidateBlock # optional: preflight prereq check (param($ctx) -> string[] of problems)

    [void] AddStep([string]$name, [scriptblock]$block) {
        $this.Steps[$name] = $block
    }

    # Recipes/archivers set this so the engine can preflight prerequisites (dirs
    # exist, password files present, tools resolvable) BEFORE any step runs — a
    # doomed archive must never cost a service its downtime. Returns a list of
    # problem strings; empty / $null means OK.
    [void] SetValidate([scriptblock]$block) {
        $this.ValidateBlock = $block
    }

    # NOT CALLED BY THE ENGINE FOR NOW. Coverage ("is this service backed up recently
    # enough?") is computed by the engine from the event log (Get-BackupPlan): every
    # bundled archiver answered it the same way, from the same service.archived
    # events. Kept for an archiver whose truth would not be in the log; such an
    # archiver would return an overdue ratio (>= 1 due, < 1 covered).
    [void] SetOverdue([scriptblock]$block) {
        $this.OverdueBlock = $block
    }

    [string] EnvValue([string]$name, [string]$fallback) {
        if ($null -ne $this.Env) {
            $prop = $this.Env.PSObject.Properties[$name]
            if ($null -ne $prop -and $null -ne $prop.Value -and "$($prop.Value)" -ne '') {
                return [string]$prop.Value
            }
        }
        return $fallback
    }

    # for archivers that delete (prunes): measure first, so the deletion is logged
    [hashtable] MeasureTree([string]$path) { return [DiskUsage]::Measure($path) }
    [string] SizeText([double]$bytes) { return [DiskUsage]::Text($bytes) }

    # Measure, then delete a tree; never throws. @{ Ok; Bytes; Files; Error }. A missing
    # path counts as deleted (0 bytes). Failures are for the caller to report.
    [hashtable] RemoveTree([string]$path) {
        $r = [DiskUsage]::Measure($path)
        $r.Ok = $true; $r.Error = $null
        if (-not (Test-Path -LiteralPath $path)) { return $r }
        $saved = $global:ProgressPreference
        try {
            $global:ProgressPreference = 'SilentlyContinue'
            Remove-Item -LiteralPath $path -Recurse -Force -ErrorAction Stop
        }
        catch { $r.Ok = $false; $r.Error = $_.Exception.Message }
        finally { $global:ProgressPreference = $saved }
        return $r
    }

    [string] RequireEnv([string]$name) {
        $v = $this.EnvValue($name, '')
        if ($v -eq '') { throw "$name not set" }
        return $v
    }

    [object[]] ReadEvents() {
        # read-only access to the sequencer event log (for archivers that route/prune by it)
        if (-not $this.EventsPath -or -not (Test-Path -LiteralPath $this.EventsPath)) { return @() }
        $out = foreach ($line in (Get-Content -LiteralPath $this.EventsPath)) {
            if ($line.Trim()) { [EventLog]::ParseLine($line) }
        }
        return @($out)
    }
}

# --- time / ids -------------------------------------------------------------

function New-RunId {
    # Unpredictable-time-friendly id: sortable UTC timestamp + random suffix (UTC so
    # ids keep sorting through the repeated hour of a DST change).
    return [datetime]::UtcNow.ToString('yyyyMMdd-HHmmss', [System.Globalization.CultureInfo]::InvariantCulture) + '-' + ('{0:x4}' -f (Get-Random -Maximum 65536))
}

function Get-NowIso {
    # event timestamps are UTC (`...Z`); displays convert to the viewer's zone
    return [datetime]::UtcNow.ToString('o', [System.Globalization.CultureInfo]::InvariantCulture)
}

# --- event log (append-only JSONL) -----------------------------------------

function Add-BackupEvent {
    param(
        [Parameter(Mandatory)][string]$EventsPath,
        [Parameter(Mandatory)][string]$Type,
        [hashtable]$Props = @{}
    )
    $dir = Split-Path -Parent $EventsPath
    if ($dir -and -not (Test-Path -LiteralPath $dir)) {
        New-Item -ItemType Directory -Force -Path $dir | Out-Null
    }
    $evt = [ordered]@{ ts = (Get-NowIso); type = $Type }
    foreach ($k in $Props.Keys) {
        $evt[$k] = $Props[$k]
    }
    Add-Content -LiteralPath $EventsPath -Value ($evt | ConvertTo-Json -Compress -Depth 20)
}

function ConvertFrom-EventLine {
    # exported wrapper of [EventLog]::ParseLine (Import-Module does not export classes)
    param([Parameter(Mandatory)][string]$Line)
    return [EventLog]::ParseLine($Line)
}

function Get-BackupEvents {
    param([Parameter(Mandatory)][string]$EventsPath)
    if (-not (Test-Path -LiteralPath $EventsPath)) {
        return @()
    }
    $events = foreach ($line in (Get-Content -LiteralPath $EventsPath)) {
        if ($line.Trim()) {
            [EventLog]::ParseLine($line)
        }
    }
    return @($events)
}

function Test-HasProp {
    param($Object, [string]$Name)
    # indexer, not .Properties.Name: StrictMode throws on .Name of an empty property list
    return ($null -ne $Object) -and ($null -ne $Object.PSObject.Properties[$Name])
}

function Get-ServiceProjection {
    # Fold the event log into a per-service summary used by planning + status.
    param([Parameter(Mandatory)][string]$EventsPath)
    $events = Get-BackupEvents -EventsPath $EventsPath
    $projection = @{}
    foreach ($e in $events) {
        if (-not (Test-HasProp $e 'svc')) {
            continue
        }
        $svc = $e.svc
        if (-not $projection.ContainsKey($svc)) {
            $projection[$svc] = [ordered]@{
                service = $svc; lastSuccess = $null; lastArchived = $null; lastStatus = $null
                lastBytes = [long]0; failCount = 0; stepDurations = @{}
            }
        }
        switch ($e.type) {
            'step.end' {
                if ((Test-HasProp $e 'durationSec') -and (Test-HasProp $e 'step')) {
                    $projection[$svc].stepDurations[$e.step] = [double]$e.durationSec
                }
            }
            'service.archived' { $projection[$svc].lastArchived = $e.ts }
            'service.end' {
                $projection[$svc].lastStatus = $e.status
                if ($e.status -eq 'ok') {
                    $projection[$svc].lastSuccess = $e.ts
                    if (Test-HasProp $e 'bytes') { $projection[$svc].lastBytes = [long]$e.bytes }
                    $projection[$svc].failCount = 0
                }
                else {
                    $projection[$svc].failCount++
                }
            }
        }
    }
    return $projection
}

function Get-EstimatedServiceSeconds {
    param([Parameter(Mandatory)]$Projection, [Parameter(Mandatory)][string]$Service)
    if (-not $Projection.ContainsKey($Service)) {
        return [double]0
    }
    $sum = [double]0
    foreach ($d in $Projection[$Service].stepDurations.Values) {
        $sum += [double]$d
    }
    return $sum
}

# --- single-instance lock ---------------------------------------------------

function Enter-SequencerLock {
    param(
        [Parameter(Mandatory)][string]$LockPath,
        [hashtable]$Info = $null      # filled with StaleLockPid when a dead holder's lock is removed
    )
    if (Test-Path -LiteralPath $LockPath) {
        $lockPid = Get-Content -LiteralPath $LockPath -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($lockPid -and (Get-Process -Id ([int]$lockPid) -ErrorAction SilentlyContinue)) {
            return $false   # another live instance holds the lock
        }
        Remove-Item -LiteralPath $LockPath -Force -ErrorAction SilentlyContinue   # stale
        if ($null -ne $Info) { $Info['StaleLockPid'] = "$lockPid" }
    }
    $dir = Split-Path -Parent $LockPath
    if ($dir -and -not (Test-Path -LiteralPath $dir)) {
        New-Item -ItemType Directory -Force -Path $dir | Out-Null
    }
    Set-Content -LiteralPath $LockPath -Value $PID
    return $true
}

function Exit-SequencerLock {
    param([Parameter(Mandatory)][string]$LockPath)
    Remove-Item -LiteralPath $LockPath -Force -ErrorAction SilentlyContinue
}

# --- window / space ---------------------------------------------------------

function Test-WithinWindow {
    param(
        [Parameter(Mandatory)][string]$Open,
        [Parameter(Mandatory)][string]$Close,
        [datetime]$Now = (Get-Date)
    )
    $openTime = [datetime]::ParseExact($Open, 'HH:mm', $null).TimeOfDay
    $closeTime = [datetime]::ParseExact($Close, 'HH:mm', $null).TimeOfDay
    $nowTime = $Now.TimeOfDay
    if ($openTime -le $closeTime) {
        return ($nowTime -ge $openTime -and $nowTime -lt $closeTime)
    }
    # window wraps past midnight (e.g. 23:00 -> 06:00)
    return ($nowTime -ge $openTime -or $nowTime -lt $closeTime)
}

function Get-WindowLengthSeconds {
    # Total length of the window, handling the past-midnight wrap.
    param([Parameter(Mandatory)][string]$Open, [Parameter(Mandatory)][string]$Close)
    $openTime = [datetime]::ParseExact($Open, 'HH:mm', $null).TimeOfDay
    $closeTime = [datetime]::ParseExact($Close, 'HH:mm', $null).TimeOfDay
    $lengthSeconds = ($closeTime - $openTime).TotalSeconds
    if ($lengthSeconds -le 0) { $lengthSeconds += 86400 }   # wraps past midnight
    return $lengthSeconds
}

function Get-SecondsUntilClose {
    # Seconds from Now until the next occurrence of the close time.
    param([Parameter(Mandatory)][string]$Close, [datetime]$Now = (Get-Date))
    $closeTime = [datetime]::ParseExact($Close, 'HH:mm', $null).TimeOfDay
    $nextClose = $Now.Date.Add($closeTime)
    if ($nextClose -le $Now) { $nextClose = $nextClose.AddDays(1) }
    return ($nextClose - $Now).TotalSeconds
}

function Get-FreeSpaceBytes {
    param([Parameter(Mandatory)][string]$Path)
    $full = $Path
    while ($full -and -not (Test-Path -LiteralPath $full)) {
        $full = Split-Path -Parent $full
    }
    if (-not $full) {
        $full = (Get-Location).Path
    }
    $best = $null
    foreach ($d in [System.IO.DriveInfo]::GetDrives()) {
        if (-not $d.IsReady) { continue }
        $root = $d.RootDirectory.FullName
        if ($full.StartsWith($root)) {
            if ($null -eq $best -or $root.Length -gt $best.RootDirectory.FullName.Length) {
                $best = $d
            }
        }
    }
    if ($best) {
        return [long]$best.AvailableFreeSpace
    }
    return [long]::MaxValue
}

function Get-PathSizeBytes {
    param([Parameter(Mandatory)][string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) {
        return [long]0
    }
    # Sum lengths directly. Avoid `(... | Measure-Object -Sum).Sum`: with zero
    # files the subexpression is $null, and $null.Sum throws under StrictMode
    # (the empty-dir crash after a cleanup/wipe step).
    $files = @(Get-ChildItem -LiteralPath $Path -Recurse -File -ErrorAction SilentlyContinue)
    $total = [long]0
    foreach ($f in $files) {
        $total += [long]$f.Length
    }
    return $total
}

# --- step execution ---------------------------------------------------------

function Limit-StepWarnings {
    # Bound what a step's warnings put in the event log: a chatty tool must not bloat
    # events.jsonl. At most $Max messages of $MaxChars each, then a "(+N more)" entry.
    param(
        [string[]]$Warnings = @(),
        [int]$Max = 20,
        [int]$MaxChars = 500
    )
    $out = @($Warnings | Select-Object -First $Max | ForEach-Object {
            if ($_.Length -gt $MaxChars) { $_.Substring(0, $MaxChars - 3) + '...' } else { $_ }
        })
    if ($Warnings.Count -gt $Max) { $out += "(+$($Warnings.Count - $Max) more)" }
    return $out
}

function Invoke-BackupStep {
    # Run one step inline with timing + retries, emitting step.begin / step.end.
    # (Hard timeout enforcement is a later iteration; timeoutSec is recorded only.)
    param(
        [Parameter(Mandatory)][string]$EventsPath,
        [Parameter(Mandatory)][string]$RunId,
        [Parameter(Mandatory)][string]$Service,
        [Parameter(Mandatory)][string]$Step,
        [Parameter(Mandatory)][scriptblock]$Action,
        [int]$Retries = 0,
        [int]$BackoffSec = 5
    )
    $attempt = 0
    while ($true) {
        Add-BackupEvent -EventsPath $EventsPath -Type 'step.begin' `
            -Props @{ runId = $RunId; svc = $Service; step = $Step; attempt = $attempt }
        $startedAt = Get-Date
        $startDetail = if ($attempt -gt 0) { "attempt $($attempt + 1)/$($Retries + 1)" } else { '' }
        Write-RunLine -RunId $RunId -Service $Service -Step $Step -Event 'begin' -Detail $startDetail
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $status = 'ok'
        $errMsg = $null
        $warnings = [System.Collections.Generic.List[string]]::new()
        try {
            # the step's warnings and info messages come out as tagged lines (service +
            # step); its other output is dropped; native tool output passes through as is.
            # Preferences forced on in the step's own scope: a caller silencing its
            # streams must not make the step's warnings vanish.
            & { $WarningPreference = 'Continue'; $InformationPreference = 'Continue'; & $Action } 3>&1 6>&1 | ForEach-Object {
                if ($_ -is [System.Management.Automation.WarningRecord]) {
                    $warnings.Add($_.Message)
                    Write-RunLine -RunId $RunId -Service $Service -Step $Step -Event 'msg' -Status 'WARN' -Detail $_.Message
                }
                elseif ($_ -is [System.Management.Automation.InformationRecord]) {
                    Write-RunLine -RunId $RunId -Service $Service -Step $Step -Event 'msg' -Detail ([string]$_.MessageData)
                }
            }
        }
        catch {
            $status = 'fail'
            $errMsg = $_.Exception.Message
        }
        $sw.Stop()
        $endDetail = 'from ' + (Format-StartRef -Start $startedAt)
        if ($errMsg) { $endDetail += "  ! $errMsg" }
        Write-RunLine -RunId $RunId -Service $Service -Step $Step -Event 'end' -Status $(if ($status -eq 'ok') { 'ok' } else { 'FAIL' }) `
            -Seconds $sw.Elapsed.TotalSeconds -Detail $endDetail
        $props = @{
            runId = $RunId; svc = $Service; step = $Step; status = $status
            durationSec = [math]::Round($sw.Elapsed.TotalSeconds, 2); attempt = $attempt
        }
        if ($errMsg) { $props.error = $errMsg }
        if ($warnings.Count -gt 0) { $props.warnings = @(Limit-StepWarnings -Warnings $warnings) }
        Add-BackupEvent -EventsPath $EventsPath -Type 'step.end' -Props $props
        if ($status -eq 'ok') {
            return 'ok'
        }
        if ($attempt -ge $Retries) {
            return 'fail'
        }
        Write-RunLine -RunId $RunId -Service $Service -Step $Step -Event 'retry' `
            -Detail "attempt $($attempt + 2)/$($Retries + 1) in ${BackoffSec}s"
        Start-Sleep -Seconds $BackoffSec
        $attempt++
    }
}

# --- planning ---------------------------------------------------------------

function Get-ScopedEnv {
    # Merge env maps along a scope chain, later sources overriding earlier ones, e.g.
    # global config.env <- service.env <- syncArchive.env. Each source is an object
    # whose properties are env vars (or $null to skip). Returns a pscustomobject.
    param([object[]]$Sources)
    $envMap = [ordered]@{}
    foreach ($src in $Sources) {
        if ($null -ne $src) {
            foreach ($prop in @($src.PSObject.Properties)) { $envMap[$prop.Name] = $prop.Value }
        }
    }
    return [pscustomobject]$envMap
}

function Get-PropOrNull {
    # StrictMode-safe property read: the value, or $null if the property is absent.
    param($Object, [string]$Name)
    if ($null -ne $Object -and (Test-HasProp $Object $Name)) { return $Object.$Name }
    return $null
}

function Get-ConfiguredStepNames {
    # the step names a service config lists, in order (empty when none)
    param($Service)
    $steps = Get-PropOrNull $Service 'steps'
    if ($null -eq $steps) { return @() }
    return @($steps | ForEach-Object { [string]$_.name })
}

function Get-ServiceValidationProblems {
    # Preflight a service: load its backup recipe and archiver (registration only),
    # run structural checks + each recipe's ValidateBlock, and return the combined
    # list of problem strings (empty = OK). Called before any step runs, so a broken
    # config is caught before downtime; also backs the standalone `validate` command.
    param(
        [Parameter(Mandatory)]$Config,
        [Parameter(Mandatory)][string]$Service,
        [Parameter(Mandatory)][string]$BaseDir,
        [Parameter(Mandatory)][string]$EventsPath,
        [datetime]$At = (Get-Date)
    )
    $svc = $Config.services.$Service
    $problems = @()

    # --- backup recipe: structural checks + its own prereq block ---
    if (-not (Test-HasProp $svc 'script') -or -not $svc.script) {
        $problems += 'no recipe script configured'
    }
    else {
        $scriptPath = Join-Path $BaseDir $svc.script
        if (-not (Test-Path -LiteralPath $scriptPath)) {
            $problems += "recipe script not found: $($svc.script)"
        }
        else {
            $rc = [RecipeContext]::new()
            $rc.Service = $Service
            $rc.EventsPath = $EventsPath
            $rc.Now = $At
            # scope chain for the backup recipe: global config.env <- service.env
            $rc.Env = Get-ScopedEnv -Sources @((Get-PropOrNull $Config 'env'), (Get-PropOrNull $svc 'env'))
            $rc.ConfiguredSteps = Get-ConfiguredStepNames $svc
            $loaded = $true
            try { & $scriptPath -Recipe $rc | Out-Null }   # registration only
            catch { $problems += "recipe failed to load: $($_.Exception.Message)"; $loaded = $false }
            if ($loaded) {
                if (-not (Test-HasProp $svc 'steps') -or $null -eq $svc.steps) {
                    $problems += 'no steps configured'
                }
                else {
                    foreach ($stepDef in $svc.steps) {
                        if (-not $rc.Steps.ContainsKey($stepDef.name)) {
                            $problems += "recipe does not register step '$($stepDef.name)'"
                        }
                    }
                }
                if ($null -ne $rc.ValidateBlock) {
                    try { $problems += @(& $rc.ValidateBlock $rc | Where-Object { $_ }) }
                    catch { $problems += "recipe validation error: $($_.Exception.Message)" }
                }
            }
        }
    }

    # --- archiver (optional): structural checks + its own prereq block ---
    if (Test-HasProp $svc 'syncArchive') {
        $sa = $svc.syncArchive
        if (-not (Test-HasProp $sa 'script') -or -not $sa.script) {
            $problems += 'syncArchive has no script'
        }
        else {
            $saScript = Join-Path $BaseDir $sa.script
            if (-not (Test-Path -LiteralPath $saScript)) {
                $problems += "archiver script not found: $($sa.script)"
            }
            else {
                $arc = [RecipeContext]::new()
                $arc.Service = $Service
                $arc.EventsPath = $EventsPath
                $arc.Now = $At
                # scope chain: global config.env <- service.env <- syncArchive.env
                $arc.Env = Get-ScopedEnv -Sources @(
                    (Get-PropOrNull $Config 'env'),
                    (Get-PropOrNull $svc 'env'),
                    (Get-PropOrNull $sa 'env'))
                $saLoaded = $true
                try { & $saScript -Recipe $arc | Out-Null }   # registration only
                catch { $problems += "archiver failed to load: $($_.Exception.Message)"; $saLoaded = $false }
                if ($saLoaded) {
                    if (-not $arc.Steps.ContainsKey('archive')) {
                        $problems += "archiver registers no 'archive' step"
                    }
                    if ($null -ne $arc.ValidateBlock) {
                        try { $problems += @(& $arc.ValidateBlock $arc | Where-Object { $_ }) }
                        catch { $problems += "archiver validation error: $($_.Exception.Message)" }
                    }
                }
            }
        }
    }

    $mode = Get-EmptyTrashMode -Config $Config -Service $Service
    if ($script:EmptyTrashModes -notcontains $mode) {
        $problems += "emptyTrash: unknown value '$mode' (use $($script:EmptyTrashModes -join ', '))"
    }
    $problems += @(Get-SpoolConfigProblems -Config $Config -Service $Service)

    return @($problems)
}

function Get-CoverageThreshold {
    # Overdue below which a service counts as covered. The margin absorbs timer jitter
    # and run length; for periods of a day or more, one hour is added on top: a timer
    # fires at a local time, so across a spring DST change only 23 real hours separate
    # two nightly runs, and the daily backup must not be skipped that night (on top,
    # not max: 23h/24h sits exactly on 1 - 1h/24h, so jitter would still skip it).
    param([double]$Margin = 0.02, $PeriodSeconds = $null)
    $slack = $Margin
    if ($null -ne $PeriodSeconds -and [double]$PeriodSeconds -ge 86400) { $slack = $Margin + 3600.0 / [double]$PeriodSeconds }
    return 1.0 - $slack
}

function Get-BackupPlan {
    # Pure: (config, projection, now) -> ALL enabled services, score-sorted.
    # Fluid scheduling — score = overdue + sizeNudge:
    #   overdue   = age / target        (how overdue vs the desired interval;
    #                                    never-run floats to the top for a baseline)
    #   sizeNudge = est / windowLength  (biggest-first tie-break + head start for big
    #                                    jobs, which need the most room to fit)
    # age dominates (whole-interval units) so rotation is fair; size only nudges ties.
    # Mandatory services are forced to the front (still score-ordered among themselves).
    # target = <service>.targetIntervalHours, else <config>.targetIntervalHours, else 24h.
    # age counts from the last backup that is really kept: the last service.archived
    # for a service with an archiver (a backup whose archive failed does not count, so
    # it is retried), else the last successful service.end.
    param(
        [Parameter(Mandatory)]$Config,
        $Projection = @{},
        [datetime]$At = (Get-Date)
    )
    $windowSeconds = Get-WindowLengthSeconds -Open $Config.window.open -Close $Config.window.close
    $defaultTargetHours = 24.0
    if (Test-HasProp $Config 'targetIntervalHours') { $defaultTargetHours = [double]$Config.targetIntervalHours }

    $entries = @()
    foreach ($serviceName in $Config.services.PSObject.Properties.Name) {
        $serviceConfig = $Config.services.$serviceName
        $enabled = (Test-HasProp $serviceConfig 'enabled') -and [bool]$serviceConfig.enabled
        if (-not $enabled) { continue }
        $isMandatory = (Test-HasProp $serviceConfig 'mandatory') -and [bool]$serviceConfig.mandatory
        $estimatedSeconds = Get-EstimatedServiceSeconds -Projection $Projection -Service $serviceName
        $lastSuccess = $null
        $lastArchived = $null
        if ($Projection.ContainsKey($serviceName)) {
            $lastSuccess = $Projection[$serviceName].lastSuccess
            if ($Projection[$serviceName].Contains('lastArchived')) { $lastArchived = $Projection[$serviceName].lastArchived }
        }
        # what counts as backed up: archived when the service has an archiver
        $lastCovered = if (Test-HasProp $serviceConfig 'syncArchive') { $lastArchived } else { $lastSuccess }

        $targetHours = $defaultTargetHours
        if (Test-HasProp $serviceConfig 'targetIntervalHours') { $targetHours = [double]$serviceConfig.targetIntervalHours }
        $targetSeconds = [math]::Max(1.0, $targetHours * 3600.0)

        # overdue = age / target; never backed up floats to the top for a first baseline
        if ($lastCovered) {
            $ageSeconds = ($At.ToUniversalTime() - ([datetime]$lastCovered).ToUniversalTime()).TotalSeconds
            if ($ageSeconds -lt 0) { $ageSeconds = 0 }
            $overdue = $ageSeconds / $targetSeconds
        }
        else {
            $ageSeconds = -1.0
            $overdue = 1e6
        }
        $sizeNudge = if ($windowSeconds -gt 0) { $estimatedSeconds / $windowSeconds } else { 0 }

        $entries += [pscustomobject]@{
            Service          = $serviceName
            Mandatory        = $isMandatory
            EstimatedSeconds = $estimatedSeconds
            LastSuccess      = $lastSuccess
            LastCovered      = $lastCovered
            AgeSeconds       = $ageSeconds
            Overdue          = $overdue
            PeriodSeconds    = $targetSeconds
            Score            = $overdue + $sizeNudge
        }
    }
    $mandatoryJobs = @($entries | Where-Object { $_.Mandatory } | Sort-Object -Property Score -Descending -Stable)
    $otherJobs = @($entries | Where-Object { -not $_.Mandatory } | Sort-Object -Property Score -Descending -Stable)
    return @($mandatoryJobs + $otherJobs)
}

# --- spool phases (wip -> stage -> ready, trash) ----------------------------

function Get-SpoolPaths {
    param([Parameter(Mandatory)][string]$SpoolRoot)
    return @{
        Wip   = Join-Path $SpoolRoot 'wip'
        Stage = Join-Path $SpoolRoot 'stage'
        Ready = Join-Path $SpoolRoot 'ready'
        Trash = Join-Path $SpoolRoot 'trash'
    }
}

# why a dir goes to trash/, as shown on a [trash] line (local-copy-dropped is routine: event only)
$script:TrashReasons = @{
    'wip-leftover'        = 'wip leftover (interrupted run?)'
    'stage-leftover'      = 'stage leftover'
    'failed-dump'         = 'partial dump of a failed backup'
    'replaced-unarchived' = 'previous backup in ready/, never archived'
    'local-copy-dropped'  = 'local copy, archived'
    'archive-failed'      = 'backup whose archive failed (only copy)'
    'error-cleanup'       = 'work dir after an error'
}

# when the archived local copy is deleted (config `emptyTrash`, root and per service)
$script:EmptyTrashModes = @('service-end', 'run-end', 'next-run', 'manual')

function Get-EmptyTrashMode {
    # <service>.emptyTrash, else <config>.emptyTrash, else next-run. A service no
    # longer in the config (or none given) gets the global value.
    param([Parameter(Mandatory)]$Config, [string]$Service = '')
    $svc = $null
    if ($Service -and (Test-HasProp $Config 'services') -and (Test-HasProp $Config.services $Service)) { $svc = $Config.services.$Service }
    $v = Get-PropOrNull $svc 'emptyTrash'
    if (-not $v) { $v = Get-PropOrNull $Config 'emptyTrash' }
    if (-not $v) { return 'next-run' }
    return [string]$v
}

# spool config (`spool` object): the root sets the path and the headroom, a service
# may override the headroom. Before a service runs, the spool must have
#   last archive size x headroomRatio + headroomGiB
# free, else the service is skipped (insufficient-space).
$script:DefaultHeadroomRatio = 1.2
$script:DefaultHeadroomGiB = 10.0

function Test-IsJsonNumber {
    param($Value)
    return ($Value -is [int] -or $Value -is [long] -or $Value -is [double] -or $Value -is [decimal])
}

function Get-SpoolConfigProblems {
    # Checks the root `spool` object, or with -Service that service's `spool` (headroom
    # only: one spool per sequencer). Absent is fine (defaults). Returns problem strings.
    param([Parameter(Mandatory)]$Config, [string]$Service = '')
    $owner = $Config
    if ($Service) { $owner = Get-PropOrNull (Get-PropOrNull $Config 'services') $Service }
    if (-not (Test-HasProp $owner 'spool')) { return @() }
    $spool = $owner.spool
    if ($spool -isnot [System.Management.Automation.PSCustomObject]) {
        if ($Service) { return @('spool: must be an object, e.g. "spool": { "headroomRatio": 1.1 }') }
        if ($spool -is [string]) {
            return @(('spool: the plain path form is no longer read; use "spool": {{ "path": "{0}" }}' -f $spool))
        }
        return @('spool: must be an object, e.g. "spool": { "path": "/var/spool/backup-sequencer" }')
    }
    $problems = @()
    $known = @('headroomRatio', 'headroomGiB')
    if (-not $Service) { $known += 'path' }
    foreach ($name in $spool.PSObject.Properties.Name) {
        if ($name -eq 'path' -and $Service) {
            $problems += 'spool.path: one spool per sequencer, set it in the top-level spool'
        }
        elseif ($known -notcontains $name) {
            $problems += "spool: unknown key '$name' (use $($known -join ', '))"
        }
    }
    if (-not $Service -and (Test-HasProp $spool 'path') -and $spool.path -isnot [string]) {
        $problems += 'spool.path: must be a string'
    }
    if (Test-HasProp $spool 'headroomRatio') {
        $v = $spool.headroomRatio
        if (-not (Test-IsJsonNumber $v) -or [double]$v -le 0) { $problems += "spool.headroomRatio: must be a number above 0 (got '$v')" }
    }
    if (Test-HasProp $spool 'headroomGiB') {
        $v = $spool.headroomGiB
        if (-not (Test-IsJsonNumber $v) -or [double]$v -lt 0) { $problems += "spool.headroomGiB: must be a number, 0 or more (got '$v')" }
    }
    return @($problems)
}

function Get-SpoolRoot {
    # spool.path from the config, else -Default (an empty path counts as unset)
    param([Parameter(Mandatory)]$Config, [Parameter(Mandatory)][string]$Default)
    $p = Get-PropOrNull (Get-PropOrNull $Config 'spool') 'path'
    if ($p -is [string] -and $p) { return $p }
    return $Default
}

function Get-SpoolHeadroom {
    # per key: <service>.spool.X, else <config>.spool.X, else the built-in default
    param([Parameter(Mandatory)]$Config, [string]$Service = '')
    $svc = $null
    if ($Service) { $svc = Get-PropOrNull (Get-PropOrNull $Config 'services') $Service }
    $ratio = $script:DefaultHeadroomRatio
    $gib = $script:DefaultHeadroomGiB
    foreach ($spool in @((Get-PropOrNull $Config 'spool'), (Get-PropOrNull $svc 'spool'))) {
        $v = Get-PropOrNull $spool 'headroomRatio'
        if ($null -ne $v) { $ratio = [double]$v }
        $v = Get-PropOrNull $spool 'headroomGiB'
        if ($null -ne $v) { $gib = [double]$v }
    }
    return @{ Ratio = $ratio; MarginBytes = [long]($gib * 1GB) }
}

function Format-SpaceNeed {
    # "974.0 GB = 802.9 GB x 1.2 + 10.0 GB"
    param([double]$NeedBytes, [double]$LastBytes, [double]$Ratio, [double]$MarginBytes)
    return [string]::Format([System.Globalization.CultureInfo]::InvariantCulture, '{0} = {1} x {2:0.###} + {3}',
        (Format-Size $NeedBytes), (Format-Size $LastBytes), $Ratio, (Format-Size $MarginBytes))
}

function Move-ToTrash {
    # Atomic rename of a dir into trash/ (instant); the reaper frees it later.
    # With -EventsPath, logs a trash.move event (ok or fail) and, unless routine, a
    # [trash] line. A failed move is logged, then rethrown: the data stays in place.
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$TrashRoot,
        [string]$EventsPath = '',
        [string]$RunId = '',
        [string]$Service = 'run',
        [string]$Reason = '',
        [switch]$PassThru   # return the item's name in trash/
    )
    if (-not (Test-Path -LiteralPath $Path)) { return }
    $name = (Split-Path -Leaf $Path) + '-' + ([guid]::NewGuid().ToString('n').Substring(0, 12))
    $label = if ($script:TrashReasons.ContainsKey($Reason)) { $script:TrashReasons[$Reason] } else { $Reason }
    try {
        if (-not (Test-Path -LiteralPath $TrashRoot)) {
            New-Item -ItemType Directory -Force -Path $TrashRoot | Out-Null
        }
        [System.IO.Directory]::Move($Path, (Join-Path $TrashRoot $name))
    }
    catch {
        $err = $_.Exception.Message
        if ($EventsPath) {
            Add-BackupEvent -EventsPath $EventsPath -Type 'trash.move' `
                -Props @{ runId = $RunId; svc = $Service; reason = $Reason; trashName = $name; status = 'fail'; error = $err }
            Write-RunLine -RunId $RunId -Service $Service -Step '[trash]' -Event 'done' -Status 'FAIL' -Detail "! $label`: $err; left in place"
        }
        throw
    }
    if ($EventsPath) {
        Add-BackupEvent -EventsPath $EventsPath -Type 'trash.move' `
            -Props @{ runId = $RunId; svc = $Service; reason = $Reason; trashName = $name; status = 'ok' }
        if ($Reason -ne 'local-copy-dropped') {
            Write-RunLine -RunId $RunId -Service $Service -Step '[trash]' -Event 'done' -Status 'ok' -Detail "$label -> trash/$name"
        }
    }
    if ($PassThru) { return $name }
}

function Move-Phase {
    # Atomic rename of a backup dir from one phase to the next (same filesystem).
    param([Parameter(Mandatory)][string]$Src, [Parameter(Mandatory)][string]$Dst)
    $parent = Split-Path -Parent $Dst
    if ($parent -and -not (Test-Path -LiteralPath $parent)) {
        New-Item -ItemType Directory -Force -Path $parent | Out-Null
    }
    [System.IO.Directory]::Move($Src, $Dst)
}

function Get-TrashMoves {
    # trashName -> the trash.move event that put it there
    param([object[]]$Events = @())
    $moves = @{}
    foreach ($e in $Events) {
        if ($e.type -eq 'trash.move' -and (Test-HasProp $e 'trashName') -and $e.status -eq 'ok') { $moves[[string]$e.trashName] = $e }
    }
    return $moves
}

function Get-TrashItems {
    # What sits in trash/, measured, with where it came from (its trash.move, if any).
    param(
        [Parameter(Mandatory)][string]$TrashRoot,
        [object[]]$Events = @()
    )
    if (-not (Test-Path -LiteralPath $TrashRoot)) { return @() }
    $moves = Get-TrashMoves -Events $Events
    return @(Get-ChildItem -LiteralPath $TrashRoot -Force -ErrorAction SilentlyContinue | Sort-Object Name | ForEach-Object {
            $size = [DiskUsage]::Measure($_.FullName)
            $m = if ($moves.ContainsKey($_.Name)) { $moves[$_.Name] } else { $null }
            [pscustomobject]@{
                Name    = $_.Name
                Bytes   = $size.Bytes
                Files   = $size.Files
                Service = if ($m) { [string]$m.svc } else { $null }
                Reason  = if ($m) { [string]$m.reason } else { $null }
                FromRun = if ($m) { [string]$m.runId } else { $null }
                MovedAt = if ($m) { $m.ts } else { $null }
            }
        })
}

function Clear-Trash {
    # Reaper: delete everything in trash/ (or the -Names given), off the publish hot
    # path. Each item is measured, deleted, and logged (trash.delete + a [delete]
    # line), tied back to the trash.move that put it there. A failed delete leaves
    # the item for the next run. -By 'command' marks a deletion asked by hand (no run).
    # Items of -HoldServices (emptyTrash manual), and items with no record when
    # -HoldUnrecorded, are left alone and counted as held.
    # Returns @{ Bytes; Items; Kept; Held; HeldBytes } for the run's end line.
    param(
        [Parameter(Mandatory)][string]$TrashRoot,
        [string]$EventsPath = '',
        [string]$RunId = '',
        [string[]]$Names = @(),
        [string]$By = '',
        [string[]]$HoldServices = @(),
        [switch]$HoldUnrecorded
    )
    $sum = @{ Bytes = [long]0; Items = 0; Kept = 0; Held = 0; HeldBytes = [long]0 }
    if (-not (Test-Path -LiteralPath $TrashRoot)) { return $sum }
    $items = @(Get-ChildItem -LiteralPath $TrashRoot -Force -ErrorAction SilentlyContinue | Sort-Object Name)
    if ($Names.Count) { $items = @($items | Where-Object { $Names -contains $_.Name }) }
    if ($items.Count -eq 0) { return $sum }
    $moves = if ($EventsPath) { Get-TrashMoves -Events @(Get-BackupEvents -EventsPath $EventsPath) } else { @{} }
    $ProgressPreference = 'SilentlyContinue'   # Remove-Item's progress bar has no place in logs
    foreach ($item in $items) {
        $size = [DiskUsage]::Measure($item.FullName)
        $hold = if ($moves.ContainsKey($item.Name)) { $HoldServices -contains [string]$moves[$item.Name].svc } else { [bool]$HoldUnrecorded }
        if ($hold) { $sum.Held++; $sum.HeldBytes += $size.Bytes; continue }
        $sw = [System.Diagnostics.Stopwatch]::StartNew()
        $err = $null
        try { Remove-Item -LiteralPath $item.FullName -Recurse -Force -ErrorAction Stop }
        catch { $err = $_.Exception.Message }
        $sw.Stop()
        if (-not $EventsPath) { continue }
        $props = @{ trashName = $item.Name; bytes = $size.Bytes; files = $size.Files
            durationSec = [math]::Round($sw.Elapsed.TotalSeconds, 2); status = $(if ($err) { 'fail' } else { 'ok' }) }
        if ($RunId) { $props.runId = $RunId }
        if ($By) { $props.by = $By }
        $svc = 'run'
        $origin = "no record: $($item.Name)"
        if ($moves.ContainsKey($item.Name)) {
            $m = $moves[$item.Name]
            $svc = [string]$m.svc
            $props.svc = $svc; $props.reason = [string]$m.reason; $props.fromRun = [string]$m.runId
            $from = [string]$m.runId
            $origin = "{0}, run {1}" -f $m.reason, $from.Substring([math]::Max(0, $from.Length - 4))
        }
        if ($err) { $props.error = $err }
        Add-BackupEvent -EventsPath $EventsPath -Type 'trash.delete' -Props $props
        if ($err) {
            $sum.Kept++
            Write-RunLine -RunId $RunId -Service $svc -Step '[delete]' -Event 'done' -Status 'FAIL' -Seconds $sw.Elapsed.TotalSeconds `
                -Detail "! $($item.Name): $err; kept$(if ($RunId) { ', retried next run' })"
        }
        else {
            $sum.Bytes += $size.Bytes; $sum.Items++
            Write-RunLine -RunId $RunId -Service $svc -Step '[delete]' -Event 'done' -Status 'ok' -Seconds $sw.Elapsed.TotalSeconds `
                -Detail ("{0}, {1} files  {2}" -f [DiskUsage]::Text($size.Bytes), $size.Files, $origin)
        }
    }
    return $sum
}

# --- run orchestration ------------------------------------------------------

function Invoke-BackupRun {
    # Narration goes to the Information stream (progress) and Warning stream
    # (notable events). Callers choose visibility via -InformationAction /
    # -WarningAction; recipes inherit the same streams.
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]$Config,
        [Parameter(Mandatory)][hashtable]$Paths,   # BaseDir, EventsPath, LockPath, SpoolRoot
        [switch]$ForceWindow,                      # run even when outside the window
        [switch]$ForceAllJobs                      # skip the fit check: attempt every job (no deferral)
    )
    Reset-RunOutput
    $lockInfo = @{}
    if (-not (Enter-SequencerLock -LockPath $Paths.LockPath -Info $lockInfo)) {
        Write-RunLine -RunId '' -Event 'skip' -Status 'WARN' -Detail ("another run is in progress (pid {0}); exiting" -f (Get-LockHolder -LockPath $Paths.LockPath))
        return
    }
    # ask tools for plain output: no colours, no redrawn progress (one line per change)
    $toolEnv = @{ NO_COLOR = '1'; COMPOSE_ANSI = 'never'; COMPOSE_PROGRESS = 'plain' }
    $savedEnv = @{}
    foreach ($k in $toolEnv.Keys) { $savedEnv[$k] = [Environment]::GetEnvironmentVariable($k); [Environment]::SetEnvironmentVariable($k, $toolEnv[$k]) }
    try {
        $runId = New-RunId
        $runClock = [System.Diagnostics.Stopwatch]::StartNew()
        $stg = Get-SpoolPaths -SpoolRoot $Paths.SpoolRoot
        foreach ($d in @($stg.Wip, $stg.Stage, $stg.Ready, $stg.Trash)) {
            if (-not (Test-Path -LiteralPath $d)) { New-Item -ItemType Directory -Force -Path $d | Out-Null }
        }

        $beginProps = @{ runId = $runId; window = "$($Config.window.open)-$($Config.window.close)"
            forced = $(if ($ForceAllJobs) { 'all' } elseif ($ForceWindow) { 'window' } else { 'none' }) }
        if ($lockInfo.ContainsKey('StaleLockPid')) { $beginProps.staleLockPid = $lockInfo['StaleLockPid'] }
        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'run.begin' -Props $beginProps
        $startDetail = "$runId  window $($Config.window.open)-$($Config.window.close)"
        if ($ForceAllJobs) { $startDetail += '  forced: window + all jobs' } elseif ($ForceWindow) { $startDetail += '  forced: window' }
        Write-RunLine -RunId $runId -Event 'begin' -Detail $startDetail
        if ($lockInfo.ContainsKey('StaleLockPid')) {
            Write-RunLine -RunId $runId -Event 'msg' -Status 'WARN' -Detail ("stale lock removed: pid {0} no longer running (previous run died?)" -f $lockInfo['StaleLockPid'])
        }
        # empty trash/ (what earlier runs dropped), logged under this run, off the publish
        # path; items of emptyTrash manual services are held for `bseq trash -Delete`
        $manualServices = @()
        if (Test-HasProp $Config 'services') {
            $manualServices = @($Config.services.PSObject.Properties.Name | Where-Object { (Get-EmptyTrashMode -Config $Config -Service $_) -eq 'manual' })
        }
        $trashSum = Clear-Trash -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId `
            -HoldServices $manualServices -HoldUnrecorded:((Get-EmptyTrashMode -Config $Config) -eq 'manual')
        $runEndTrash = [System.Collections.Generic.List[string]]::new()   # emptyTrash run-end: deleted before run.end

        $projection = Get-ServiceProjection -EventsPath $Paths.EventsPath
        $planNow = Get-Date
        $plan = Get-BackupPlan -Config $Config -Projection $projection -At $planNow
        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'run.plan' `
            -Props @{ runId = $runId; plan = @($plan.Service) }

        $okCount = 0
        $failCount = 0
        $ranGuaranteed = $false   # has a non-mandatory job started this run? (fluid: >=1 per window)
        # coverage grace: treat a service as covered only if it is comfortably inside its
        # period, not right at the edge. A ~daily timer fires at ~24h intervals; with no
        # slack, a night that triggers a hair early lands age just under the period
        # (overdue ~0.999) and the backup is wrongly skipped. The margin (default 2%, ~29
        # min for a daily) absorbs timer jitter + backup duration. Override via config.
        $coverageMargin = 0.02
        if (Test-HasProp $Config 'coverageMargin') { $coverageMargin = [double]$Config.coverageMargin }
        foreach ($plannedJob in $plan) {
            # hard window gate: never START work past close (a running job may overrun)
            if (-not $ForceWindow -and -not (Test-WithinWindow -Open $Config.window.open -Close $Config.window.close)) {
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'run.windowclosed' -Props @{ runId = $runId }
                if (($okCount + $failCount) -gt 0) {
                    Write-RunLine -RunId $runId -Event 'closed' -Detail ("window {0}-{1} closed; remaining services deferred to the next run" -f $Config.window.open, $Config.window.close)
                }
                else {
                    Write-RunLine -RunId $runId -Event 'closed' -Detail ("outside the backup window ({0}-{1}); nothing run. Use -ForceWindow to override" -f $Config.window.open, $Config.window.close)
                }
                break
            }
            $serviceName = $plannedJob.Service

            # coverage gate: skip a service already backed up for its period (its last
            # archive, of any tier, is younger than its interval, within the grace
            # margin). No backup produced, so no wasted downtime.
            # -ForceAllJobs overrides.
            if (-not $ForceAllJobs -and $plannedJob.Overdue -lt (Get-CoverageThreshold -Margin $coverageMargin -PeriodSeconds $plannedJob.PeriodSeconds)) {
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.skip' `
                    -Props @{ runId = $runId; svc = $serviceName; reason = 'covered'; overdue = [math]::Round([double]$plannedJob.Overdue, 3) }
                Write-RunLine -RunId $runId -Service $serviceName -Event 'skip' -Detail ([string]::Format([System.Globalization.CultureInfo]::InvariantCulture, 'covered (x{0:0.00})', $plannedJob.Overdue))
                continue
            }

            # fluid fit decision: start a service only if its estimate fits the time
            # left before close. Exceptions that still run: an unknown estimate
            # (first-ever, optimistic) and the FIRST non-mandatory job of the run
            # (guaranteed progress — lets an over-window job take a solo night when it
            # is the most overdue). Mandatory and -ForceAllJobs bypass the check.
            if (-not $ForceAllJobs -and -not $plannedJob.Mandatory) {
                $estimatedSeconds = [double]$plannedJob.EstimatedSeconds
                $remainingSeconds = Get-SecondsUntilClose -Close $Config.window.close
                $fitsInWindow = ($estimatedSeconds -le 0) -or ($estimatedSeconds -le $remainingSeconds)
                if (-not $fitsInWindow -and $ranGuaranteed) {
                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.skip' `
                        -Props @{ runId = $runId; svc = $serviceName; reason = 'deferred'; estSec = [int]$estimatedSeconds; remainingSec = [int]$remainingSeconds }
                    Write-RunLine -RunId $runId -Service $serviceName -Event 'skip' -Detail ("deferred (est {0}, {1} left in window)" -f (Format-DurationUnit $estimatedSeconds), (Format-DurationUnit $remainingSeconds))
                    continue
                }
                $ranGuaranteed = $true
            }

            $wipDir = Join-Path $stg.Wip $serviceName
            $stageDir = Join-Path $stg.Stage $serviceName
            $readyDir = Join-Path $stg.Ready $serviceName
            $svcClock = [System.Diagnostics.Stopwatch]::StartNew()
            $estText = if (-not $plannedJob.LastSuccess -and $plannedJob.EstimatedSeconds -le 0) { '?' } else { Format-DurationUnit $plannedJob.EstimatedSeconds }
            $beginDetail = "est $estText"
            if ($plannedJob.Mandatory) { $beginDetail += '  mandatory' }
            Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.begin' `
                -Props @{ runId = $runId; svc = $serviceName; mandatory = [bool]$plannedJob.Mandatory
                    estSec = $(if ($estText -eq '?') { -1 } else { [int]$plannedJob.EstimatedSeconds }) }
            Write-RunLine -RunId $runId -Service $serviceName -Event 'begin' -Detail $beginDetail
            try {
            # isolate per-service failures: an unhandled error here fails only this service
            $svc = $Config.services.$serviceName
            $scriptPath = Join-Path $Paths.BaseDir $svc.script

            # preflight: a doomed config (missing password file, unset ARCHIVE_DEST,
            # unregistered step, …) must be caught BEFORE any step runs, so a broken
            # archive never costs the service its downtime. Skip it (counted failed, so
            # coverage keeps it overdue and it shows in the report); other services run.
            $vp = @(Get-ServiceValidationProblems -Config $Config -Service $serviceName -BaseDir $Paths.BaseDir -EventsPath $Paths.EventsPath -At $planNow)
            if ($vp.Count) {
                $failCount++
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.end' `
                    -Props @{ runId = $runId; svc = $serviceName; status = 'fail'; reason = 'invalid'; error = 'invalid config'; problems = @($vp); bytes = 0 }
                Write-RunLine -RunId $runId -Service $serviceName -Event 'end' -Status 'FAIL' -Seconds $svcClock.Elapsed.TotalSeconds `
                    -Detail ("! invalid, no step run: {0}" -f ($vp -join '; '))
                continue
            }

            # pre-flight free-space check: last recorded size x headroomRatio + headroomGiB
            if ($projection.ContainsKey($serviceName) -and $projection[$serviceName].lastBytes -gt 0) {
                $lastBytes = [long]$projection[$serviceName].lastBytes
                $headroom = Get-SpoolHeadroom -Config $Config -Service $serviceName
                $need = [long]($lastBytes * $headroom.Ratio + $headroom.MarginBytes)
                $free = Get-FreeSpaceBytes -Path $Paths.SpoolRoot
                if ($free -lt $need) {
                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.skip' `
                        -Props @{ runId = $runId; svc = $serviceName; reason = 'insufficient-space'; needBytes = $need; freeBytes = $free
                            lastBytes = $lastBytes; ratio = $headroom.Ratio; marginBytes = $headroom.MarginBytes }
                    Write-RunLine -RunId $runId -Service $serviceName -Event 'skip' -Status 'WARN' `
                        -Detail ("insufficient space in the spool (need {0}, free {1})" -f (Format-SpaceNeed $need $lastBytes $headroom.Ratio $headroom.MarginBytes), (Format-Size $free))
                    continue
                }
            }

            # fresh wip dir (clear any leftover from a prior crash)
            Move-ToTrash -Path $wipDir -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Service $serviceName -Reason 'wip-leftover'
            New-Item -ItemType Directory -Force -Path $wipDir | Out-Null

            # --- load the recipe (it registers its steps) and produce into wip/<service> ---
            $rc = [RecipeContext]::new()
            $rc.Service = $serviceName
            $rc.OutDir = $wipDir
            # scope chain for the backup recipe: global config.env <- service.env
            $rc.Env = Get-ScopedEnv -Sources @((Get-PropOrNull $Config 'env'), (Get-PropOrNull $svc 'env'))
            $rc.EventsPath = $Paths.EventsPath
            $rc.RunId = $runId
            $rc.ConfiguredSteps = Get-ConfiguredStepNames $svc
            & $scriptPath -Recipe $rc | Out-Null   # registration only; don't let output taint the run

            $failed = $false
            $failedStep = $null
            foreach ($stepDef in $svc.steps) {
                $stepName = $stepDef.name
                $always = (Test-HasProp $stepDef 'alwaysRun') -and $stepDef.alwaysRun
                if ($failed -and -not $always) {
                    continue   # skip normal steps after a failure, but still run recovery (e.g. start)
                }
                $retries = 0
                if (Test-HasProp $stepDef 'retries') { $retries = [int]$stepDef.retries }
                if ($rc.Steps.ContainsKey($stepName)) {
                    $stepBlock = $rc.Steps[$stepName]
                    $action = { & $stepBlock $rc }.GetNewClosure()
                }
                else {
                    $missing = $stepName
                    $action = { throw "recipe did not register step '$missing'" }.GetNewClosure()
                }
                $r = Invoke-BackupStep -EventsPath $Paths.EventsPath -RunId $runId `
                    -Service $serviceName -Step $stepName -Action $action -Retries $retries
                if ($r -ne 'ok' -and -not $failedStep) { $failedStep = $stepName }
                if ($r -ne 'ok' -and -not $always) { $failed = $true }
            }

            if ($failed) {
                Move-ToTrash -Path $wipDir -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Service $serviceName -Reason 'failed-dump'
                $failCount++
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.end' `
                    -Props @{ runId = $runId; svc = $serviceName; status = 'fail'; bytes = 0; error = "step $failedStep failed" }
                Write-RunLine -RunId $runId -Service $serviceName -Event 'end' -Status 'FAIL' -Seconds $svcClock.Elapsed.TotalSeconds `
                    -Detail "! step $failedStep failed; partial dump discarded"
                continue
            }

            $bytes = Get-PathSizeBytes -Path $wipDir

            # --- promote wip -> stage ---
            Move-ToTrash -Path $stageDir -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Service $serviceName -Reason 'stage-leftover'
            Move-Phase -Src $wipDir -Dst $stageDir

            # --- optional synchronous archive step, on stage/<service> ---
            $syncFailed = $false
            $droppedName = $null   # the stage dir's name in trash/, when dropped
            $archNote = ''   # archive result, shown on the service's final line
            if (Test-HasProp $svc 'syncArchive') {
                $sa = $svc.syncArchive
                $saScript = Join-Path $Paths.BaseDir $sa.script
                if (-not (Test-Path -LiteralPath $saScript)) {
                    $syncFailed = $true
                    $reason = "recipe not found: $($sa.script)"
                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.syncfail' `
                        -Props @{ runId = $runId; svc = $serviceName; reason = $reason }
                    Write-RunLine -RunId $runId -Service $serviceName -Event 'msg' -Status 'FAIL' -Detail "! archive not run: $reason"
                }
                else {
                    $arc = [RecipeContext]::new()
                    $arc.Service = $serviceName
                    $arc.OutDir = $stageDir
                    $arc.EventsPath = $Paths.EventsPath
                    $arc.RunId = $runId
                    # scope chain: global config.env <- service.env <- syncArchive.env
                    $arc.Env = Get-ScopedEnv -Sources @(
                        (Get-PropOrNull $Config 'env'),
                        (Get-PropOrNull $svc 'env'),
                        (Get-PropOrNull $sa 'env'))
                    & $saScript -Recipe $arc | Out-Null
                    if (-not $arc.Steps.ContainsKey('archive')) {
                        $syncFailed = $true
                        $reason = "recipe did not register an 'archive' step"
                        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.syncfail' `
                            -Props @{ runId = $runId; svc = $serviceName; reason = $reason }
                        Write-RunLine -RunId $runId -Service $serviceName -Event 'msg' -Status 'FAIL' -Detail "! archive not run: $reason"
                    }
                    else {
                        $archiveBlock = $arc.Steps['archive']
                        $saAction = { & $archiveBlock $arc }.GetNewClosure()
                        $rsa = Invoke-BackupStep -EventsPath $Paths.EventsPath -RunId $runId `
                            -Service $serviceName -Step 'sync-archive' -Action $saAction
                        $syncFailed = ($rsa -ne 'ok')
                        if ($syncFailed) {
                            $reason = (Get-BackupEvents -EventsPath $Paths.EventsPath |
                                Where-Object { $_.type -eq 'step.end' -and $_.svc -eq $serviceName -and $_.step -eq 'sync-archive' -and $_.status -eq 'fail' } |
                                Select-Object -Last 1).error
                            if (-not $reason) { $reason = 'see events.jsonl' }
                            Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.syncfail' `
                                -Props @{ runId = $runId; svc = $serviceName; reason = $reason }
                            # the step's own FAIL line already carries the reason
                        }
                        else {
                            # record the archive in the sequencer log (reported by the recipe)
                            $res = if ($arc.State.ContainsKey('Result')) { $arc.State['Result'] } else { @{} }
                            $props = @{ runId = $runId; svc = $serviceName }
                            if ($res -is [hashtable]) {
                                if ($res.ContainsKey('tier') -and $res['tier']) { $props['tier'] = $res['tier'] }
                                if ($res.ContainsKey('path') -and $res['path']) { $props['path'] = $res['path'] }
                                # identity for path-less archivers (e.g. restic snapshot id)
                                if ($res.ContainsKey('snapshot') -and $res['snapshot']) { $props['snapshot'] = $res['snapshot'] }
                                if ($res.ContainsKey('repo') -and $res['repo']) { $props['repo'] = $res['repo'] }
                            }
                            Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.archived' -Props $props
                            # record any archives the recipe pruned (log-driven retention)
                            # (a recipe may report a plain path, or @{ path; bytes; files })
                            $prunedCount = 0
                            if (($res -is [hashtable]) -and $res.ContainsKey('pruned') -and $res['pruned']) {
                                foreach ($pp in @($res['pruned'])) {
                                    $pe = @{ runId = $runId; svc = $serviceName }
                                    if ($pp -is [hashtable]) { foreach ($k in $pp.Keys) { $pe[$k] = $pp[$k] } } else { $pe.path = [string]$pp }
                                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.archive-pruned' -Props $pe
                                }
                                $prunedCount = @($res['pruned']).Count
                            }
                            # a prune that failed is not recorded as pruned: the archive stays live
                            # and the next run prunes it again; the service stays ok
                            $pruneFailCount = 0
                            if (($res -is [hashtable]) -and $res.ContainsKey('pruneFailed') -and $res['pruneFailed']) {
                                foreach ($pf in @($res['pruneFailed'])) {
                                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.archive-prunefail' `
                                        -Props @{ runId = $runId; svc = $serviceName; path = [string]$pf.path; status = 'fail'; error = [string]$pf.error }
                                }
                                $pruneFailCount = @($res['pruneFailed']).Count
                            }
                            if ($props.ContainsKey('path')) { $archNote = "archived to $($props['path'])" }
                            elseif ($props.ContainsKey('snapshot')) { $archNote = 'snap ' + ([string]$props['snapshot']).Substring(0, [math]::Min(8, ([string]$props['snapshot']).Length)) }
                            else { $archNote = 'archived' }
                            if ($props.ContainsKey('tier')) { $archNote += " ($($props['tier']))" }
                            if ($prunedCount -gt 0) { $archNote += ", pruned $prunedCount" }
                            if ($pruneFailCount -gt 0) { $archNote += ", $pruneFailCount prune failed" }
                        }
                    }
                }
            }

            # --- publish stage -> ready (or discard if sync-only) ---
            # publishToReady is honored as configured, even on sync-archive failure.
            # Forcing it true on failure would be wrong: when it is false there is no
            # consumer watching ready/, so a backup stranded there is never fetched. A
            # failed archive writes no service.archived event, so coverage keeps the
            # service overdue and the next window retries it (the recovery path).
            $publishToReady = $true
            if (Test-HasProp $svc 'publishToReady') { $publishToReady = [bool]$svc.publishToReady }

            if ($publishToReady) {
                if (Test-Path -LiteralPath $readyDir) {
                    # previous backup never taken by the archiver: replace + notify
                    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.replaced' `
                        -Props @{ runId = $runId; svc = $serviceName; reason = 'previous-unarchived' }
                    Move-ToTrash -Path $readyDir -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Service $serviceName -Reason 'replaced-unarchived'
                    Write-RunLine -RunId $runId -Service $serviceName -Event 'msg' -Status 'WARN' -Detail 'replaced the previous backup in ready/, never taken by the archiver (archiver behind)'
                }
                Move-Phase -Src $stageDir -Dst $readyDir
            }
            else {
                # archived synchronously (or nothing to keep); a copy whose archive failed
                # is the only one left: its own reason, never deleted early
                $dropReason = if ($syncFailed) { 'archive-failed' } else { 'local-copy-dropped' }
                $droppedName = Move-ToTrash -Path $stageDir -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Service $serviceName -Reason $dropReason -PassThru
            }

            # A sync-archive failure with no local copy kept means nothing was archived
            # and nothing retained: a service failure. With a copy in ready/, the async
            # archiver still has the backup, so that case stays ok (syncfail reported).
            $sizeText = Format-Size $bytes
            if ($syncFailed -and -not $publishToReady) {
                $failCount++
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.end' `
                    -Props @{ runId = $runId; svc = $serviceName; status = 'fail'; bytes = $bytes; kept = 'dropped'; error = 'sync-archive failed; nothing retained' }
                Write-RunLine -RunId $runId -Service $serviceName -Event 'end' -Status 'FAIL' -Seconds $svcClock.Elapsed.TotalSeconds `
                    -Detail "$sizeText  ! archive failed, nothing retained (retried next window)"
            }
            else {
                $okCount++
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.end' `
                    -Props @{ runId = $runId; svc = $serviceName; status = 'ok'; bytes = $bytes; kept = $(if ($publishToReady) { 'ready' } else { 'dropped' }) }
                $notes = @()
                if ($archNote) { $notes += $archNote }
                if ($syncFailed) { $notes += 'archive failed' }
                $notes += $(if ($publishToReady) { "kept in ready/$serviceName" } else { 'local copy dropped' })
                Write-RunLine -RunId $runId -Service $serviceName -Event 'end' -Status 'ok' -Seconds $svcClock.Elapsed.TotalSeconds `
                    -Detail ("{0}  {1}" -f $sizeText, ($notes -join ', '))
            }

            # emptyTrash: the archived local copy (only that) may go now, at run end, or never
            if ($droppedName -and (Test-HasProp $svc 'syncArchive') -and -not $syncFailed) {
                switch (Get-EmptyTrashMode -Config $Config -Service $serviceName) {
                    'service-end' { Add-TrashSum -Total $trashSum -Sum (Clear-Trash -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Names @($droppedName)) }
                    'run-end' { $runEndTrash.Add($droppedName) }
                    'manual' {
                        $size = [DiskUsage]::Measure((Join-Path $stg.Trash $droppedName))
                        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'trash.hold' `
                            -Props @{ runId = $runId; svc = $serviceName; trashName = $droppedName; reason = 'local-copy-dropped'; bytes = $size.Bytes; files = $size.Files }
                        Write-RunLine -RunId $runId -Service $serviceName -Step '[delete]' -Event 'skip' `
                            -Detail ("held (emptyTrash manual): {0}, {1} files; bseq trash -Delete {2}" -f [DiskUsage]::Text($size.Bytes), $size.Files, $droppedName)
                    }
                }
            }
            }
            catch {
                $emsg = $_.Exception.Message
                $failCount++
                Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'service.end' `
                    -Props @{ runId = $runId; svc = $serviceName; status = 'fail'; bytes = 0; error = $emsg }
                Write-RunLine -RunId $runId -Service $serviceName -Event 'end' -Status 'FAIL' -Seconds $svcClock.Elapsed.TotalSeconds -Detail "! $emsg"
                # each move is logged (ok or fail) by Move-ToTrash; a failure here must not mask the service error
                try { Move-ToTrash -Path $wipDir -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Service $serviceName -Reason 'error-cleanup' } catch { }
                try { Move-ToTrash -Path $stageDir -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Service $serviceName -Reason 'error-cleanup' } catch { }
            }
        }

        if ($runEndTrash.Count) {
            Add-TrashSum -Total $trashSum -Sum (Clear-Trash -TrashRoot $stg.Trash -EventsPath $Paths.EventsPath -RunId $runId -Names @($runEndTrash))
        }
        $endProps = @{ runId = $runId; status = $(if ($failCount -gt 0) { 'fail' } else { 'ok' }); summary = @{ ok = $okCount; failed = $failCount; planned = $plan.Count } }
        if ($trashSum.Held -gt 0) { $endProps.trashHeld = @{ items = $trashSum.Held; bytes = $trashSum.HeldBytes } }
        Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'run.end' -Props $endProps
        Write-RunLine -RunId $runId -Event 'end' -Status $(if ($failCount -gt 0) { 'FAIL' } else { 'ok' }) -Seconds $runClock.Elapsed.TotalSeconds `
            -Detail (("{0} ok, {1} failed, {2} planned" -f $okCount, $failCount, $plan.Count) + (Format-TrashTotals $trashSum))
        return $runId
    }
    finally {
        foreach ($k in $savedEnv.Keys) { [Environment]::SetEnvironmentVariable($k, $savedEnv[$k]) }
        Exit-SequencerLock -LockPath $Paths.LockPath
    }
}

# --- reporting --------------------------------------------------------------

function Send-RunReport {
    # After a run: mail its report when notify is enabled, and record the outcome
    # (notify.send + a [notify] line), so a mail that never left shows in show/history.
    param(
        [Parameter(Mandatory)]$Config,
        [Parameter(Mandatory)][hashtable]$Paths,
        [Parameter(Mandatory)][string]$RunId,
        [string]$BaseDir = '.'
    )
    if (-not ((Test-HasProp $Config 'notify') -and (Test-HasProp $Config.notify 'enabled') -and $Config.notify.enabled)) { return }
    $report = Format-RunReport -EventsPath $Paths.EventsPath -RunId $RunId
    $r = Send-BackupReport -Notify $Config.notify -Subject "backup report $RunId" -Body $report -BaseDir $BaseDir
    $props = @{ runId = $RunId; status = $(if ($r.Sent) { 'ok' } else { 'fail' }); to = @($Config.notify.to).Count }
    if ($r.Error) { $props.error = $r.Error }
    Add-BackupEvent -EventsPath $Paths.EventsPath -Type 'notify.send' -Props $props
    if ($r.Sent) { Write-RunLine -RunId $RunId -Step '[notify]' -Event 'done' -Status 'ok' -Detail ("report mailed to {0} recipient(s)" -f $props.to) }
    else { Write-RunLine -RunId $RunId -Step '[notify]' -Event 'done' -Status 'FAIL' -Detail "! $($r.Error)" }
}

function Format-RunReport {
    # Render a terse text report for one run (reused by history + notifications).
    param(
        [Parameter(Mandatory)][string]$EventsPath,
        [Parameter(Mandatory)][string]$RunId
    )
    $events = Get-BackupEvents -EventsPath $EventsPath | Where-Object { (Test-HasProp $_ 'runId') -and $_.runId -eq $RunId }
    $lines = @("Backup run $RunId")
    foreach ($e in ($events | Where-Object { $_.type -eq 'service.end' })) {
        $mb = [math]::Round(($e.bytes / 1MB), 1)
        $lines += ("  {0,-24} {1,-5} {2} MB" -f $e.svc, $e.status.ToUpper(), $mb)
    }
    # surface preflight-invalid services (skipped before any step, so no downtime)
    foreach ($e in ($events | Where-Object { $_.type -eq 'service.end' -and (Test-HasProp $_ 'reason') -and $_.reason -eq 'invalid' })) {
        $probs = if (Test-HasProp $e 'problems') { @($e.problems) } else { @('see events.jsonl') }
        foreach ($p in $probs) { $lines += ("  ! {0,-22} invalid: {1}" -f $e.svc, $p) }
    }
    # surface sync-archive failures even when the backup was still published (ok)
    foreach ($e in ($events | Where-Object { $_.type -eq 'service.syncfail' })) {
        $reason = if (Test-HasProp $e 'reason') { $e.reason } else { 'see events.jsonl' }
        $lines += ("  ! {0,-22} archive failed: {1}" -f $e.svc, $reason)
    }
    # step warnings and engine warnings (replaced backup, spool out of space), worded as in `show`
    $detail = Get-RunDetail -Events @($events) -Run ([pscustomobject]@{ RunId = $RunId })
    foreach ($s in $detail.Services) {
        foreach ($w in $s.Warnings) { $lines += ("  ! {0,-22} {1}" -f $s.Service, $w) }
    }
    foreach ($d in @($detail.Deletions | Where-Object { $_.Kind -eq 'delete' -and -not $_.Ok })) {
        $lines += ("  ! {0,-22} trash item {1}" -f $d.Service, $d.Detail)
    }
    if (@($detail.Deletions).Count) { $lines += ("  -- {0}" -f (Format-DeletionTotals $detail.Deletions)) }
    if ($detail.Held) {
        $lines += ("  -- trash held: {0} item{1}, {2} (emptyTrash manual: bseq trash)" -f $detail.Held.Items,
            $(if ($detail.Held.Items -gt 1) { 's' } else { '' }), (Format-Size $detail.Held.Bytes))
    }
    $end =$events | Where-Object { $_.type -eq 'run.end' } | Select-Object -First 1
    if ($end) {
        $lines += ("  -- ok={0} failed={1} planned={2}" -f $end.summary.ok, $end.summary.failed, $end.summary.planned)
    }
    return ($lines -join "`n")
}

function Send-BackupReport {
    # Send a report via swaks over SMTP. Keep the body terse (no secrets). Never
    # throws: returns @{ Sent; Error }, Sent = $false with Error = $null when notify is
    # disabled (and -Force not given). swaks' own output is kept for the error.
    param(
        [Parameter(Mandatory)]$Notify,     # config.notify object
        [Parameter(Mandatory)][string]$Subject,
        [Parameter(Mandatory)][string]$Body,
        [string]$BaseDir = '.',            # passwordFile is relative to it (the config dir)
        [switch]$Force                     # send even when notify.enabled is false (test-notify)
    )
    $r = @{ Sent = $false; Error = $null }
    if (-not $Force -and -not ((Test-HasProp $Notify 'enabled') -and $Notify.enabled)) { return $r }
    $swaks = if ((Test-HasProp $Notify 'swaks') -and $Notify.swaks) { [string]$Notify.swaks } else { 'swaks' }
    if (-not (Get-Command $swaks -ErrorAction SilentlyContinue)) { $r.Error = "swaks not found ($swaks)"; return $r }
    $passFile = Join-Path $BaseDir $Notify.passwordFile
    if (-not (Test-Path -LiteralPath $passFile)) { $r.Error = "SMTP password file not found: $passFile"; return $r }
    $pass = (Get-Content -LiteralPath $passFile -Raw).Trim()
    $tmp = New-TemporaryFile
    Set-Content -LiteralPath $tmp -Value $Body
    $errors = @()
    try {
        foreach ($to in @($Notify.to)) {
            $out = & $swaks --to $to --from $Notify.from `
                --server $Notify.server --auth-user $Notify.authUser --auth-password $pass `
                --header "Subject: $Subject" --body $tmp 2>&1
            if ($LASTEXITCODE -ne 0) {
                # swaks' last lines say why (e.g. "<** 535 Authentication failed"); never the password
                $why = @($out | ForEach-Object { [string]$_ } | Where-Object { $_.Trim() } | Select-Object -Last 2) -join ' / '
                $errors += "to $to`: swaks exit $LASTEXITCODE$(if ($why) { ": $why" })"
            }
        }
    }
    finally {
        Remove-Item -LiteralPath $tmp -Force -ErrorAction SilentlyContinue
    }
    if ($errors.Count) { $r.Error = $errors -join '; ' } else { $r.Sent = $true }
    return $r
}

# --- run status / detail (status, show, history) ----------------------------

function Format-Duration {
    # compact, culture-independent duration: 7.5s, 42s, 5m02s, 1h03m
    param([double]$Seconds)
    $inv = [System.Globalization.CultureInfo]::InvariantCulture
    if ($Seconds -lt 0) { $Seconds = 0 }
    if ($Seconds -lt 10) { return [string]::Format($inv, '{0:0.#}s', $Seconds) }
    $s = [long][math]::Round($Seconds)
    if ($s -lt 60) { return "${s}s" }
    if ($s -lt 3600) { return [string]::Format($inv, '{0}m{1:00}s', [math]::Floor($s / 60), $s % 60) }
    return [string]::Format($inv, '{0}h{1:00}m', [math]::Floor($s / 3600), [math]::Floor(($s % 3600) / 60))
}

function Format-DurationUnit {
    # one readable unit, for estimates: <1s, 38s, 55m, 1.2h ('?' for a negative = unknown)
    param([double]$Seconds)
    $inv = [System.Globalization.CultureInfo]::InvariantCulture
    if ($Seconds -lt 0) { return '?' }
    if ($Seconds -lt 0.5) { return '<1s' }
    if ($Seconds -lt 90) { return [string]::Format($inv, '{0:0}s', $Seconds) }
    if ($Seconds -lt 90 * 60) { return [string]::Format($inv, '{0:0}m', $Seconds / 60) }
    return [string]::Format($inv, '{0:0.0}h', $Seconds / 3600)
}

function Format-RunLine {
    # One run-output line: fixed columns, no indentation, every line self-contained
    # (run, service, step) so parallel jobs stay readable.
    #   runid(4)  [time(8)]  service(18)  step(12)  event(6)  status(4)  dur(6)  detail
    # event = what happens (start, end, msg, ...); status = outcome (ok, FAIL, WARN).
    # $Time = $null drops the time column (journald stamps lines itself).
    param(
        [string]$RunId,
        $Time = $null,
        [string]$Service = 'run',
        [string]$Step = '-',
        [string]$Event = '',
        [string]$Status = '',
        [string]$Duration = '',
        [string]$Detail = ''
    )
    $fit = {
        param([string]$s, [int]$w)
        if ($s.Length -gt $w) { return $s.Substring(0, $w - 1) + '~' }
        return $s.PadRight($w)
    }
    $id = if ($RunId) { $RunId.Substring([math]::Max(0, $RunId.Length - 4)) } else { '----' }
    $parts = @(& $fit $id 4)
    if ($null -ne $Time) { $parts += ([datetime]$Time).ToString('HH:mm:ss', [System.Globalization.CultureInfo]::InvariantCulture) }
    $parts += @((& $fit $Service 18), (& $fit $Step 12), (& $fit $Event 6), (& $fit $Status 4), (& $fit $Duration 6), $Detail)
    return ($parts -join '  ').TrimEnd()
}

function Format-TrashTotals {
    # "  freed 47.1 GB (3 items), 1 trash item kept" for the run's end line; '' when nothing happened
    param($Sum)
    if ($null -eq $Sum) { return '' }
    $held = if ($Sum.ContainsKey('Held')) { $Sum.Held } else { 0 }
    if ($Sum.Items -eq 0 -and $Sum.Kept -eq 0 -and $held -eq 0) { return '' }
    $parts = @()
    if ($Sum.Items -gt 0) { $parts += "freed {0} ({1} item{2})" -f [DiskUsage]::Text($Sum.Bytes), $Sum.Items, $(if ($Sum.Items -gt 1) { 's' } else { '' }) }
    if ($Sum.Kept -gt 0) { $parts += "{0} trash item{1} kept" -f $Sum.Kept, $(if ($Sum.Kept -gt 1) { 's' } else { '' }) }
    if ($held -gt 0) { $parts += "{0} held in trash ({1})" -f $held, [DiskUsage]::Text($Sum.HeldBytes) }
    return '  ' + ($parts -join ', ')
}

function Add-TrashSum {
    # fold one Clear-Trash result into a run total
    param([Parameter(Mandatory)][hashtable]$Total, $Sum)
    if ($null -eq $Sum) { return }
    foreach ($k in @($Sum.Keys)) { if ($Total.ContainsKey($k)) { $Total[$k] += $Sum[$k] } else { $Total[$k] = $Sum[$k] } }
}

function Format-StartRef {
    # "from" reference for an end line: HH:mm:ss, with MM-dd when the start was another day
    param([datetime]$Start, [datetime]$Now = (Get-Date))
    $inv = [System.Globalization.CultureInfo]::InvariantCulture
    if ($Start.Date -eq $Now.Date) { return $Start.ToString('HH:mm:ss', $inv) }
    return $Start.ToString('MM-dd HH:mm:ss', $inv)
}

# run-output writer state: time column on a terminal only, date line on date change
$script:RunOut = @{ ShowTime = $true; LastDate = $null }

function Reset-RunOutput {
    # journald sets JOURNAL_STREAM for a service's stdout and stamps each line itself
    $script:RunOut = @{ ShowTime = (-not $env:JOURNAL_STREAM); LastDate = $null }
}

function Write-RunLine {
    # Emit one formatted run line on the Information stream (the CLI shows it).
    param(
        [string]$RunId,
        [string]$Service = 'run',
        [string]$Step = '-',
        [Parameter(Mandatory)][string]$Event,
        [ValidateSet('', 'ok', 'FAIL', 'WARN')][string]$Status = '',
        [double]$Seconds = -1,          # duration column; negative = none
        [string]$Detail = ''
    )
    $now = Get-Date
    $time = $null
    if ($script:RunOut.ShowTime) {
        if ($script:RunOut.LastDate -ne $now.Date) {
            $script:RunOut.LastDate = $now.Date
            Write-Information ($now.ToString('yyyy-MM-dd', [System.Globalization.CultureInfo]::InvariantCulture) + ' ' + ('-' * 70))
        }
        $time = $now
    }
    $dur = if ($Seconds -ge 0) { Format-Duration $Seconds } else { '' }
    Write-Information (Format-RunLine -RunId $RunId -Time $time -Service $Service -Step $Step -Event $Event -Status $Status -Duration $dur -Detail $Detail)
}

function Format-Size {
    # compact, culture-independent byte size: 812 KB, 7.2 MB, 52.4 GB
    param([double]$Bytes)
    return [DiskUsage]::Text($Bytes)
}

function Format-EventTime {
    # ISO 8601 with offset, independent of the pwsh culture (events parse to [datetime])
    param($Ts)
    if ($null -eq $Ts -or "$Ts" -eq '') { return '?' }
    try { return ([datetime]$Ts).ToLocalTime().ToString('yyyy-MM-ddTHH:mm:sszzz', [System.Globalization.CultureInfo]::InvariantCulture) } catch { return [string]$Ts }
}

function Get-LockHolder {
    # pid of the live process holding the sequencer lock, or $null (no lock / stale lock)
    param([string]$LockPath)
    if (-not $LockPath -or -not (Test-Path -LiteralPath $LockPath)) { return $null }
    $lockPid = Get-Content -LiteralPath $LockPath -ErrorAction SilentlyContinue | Select-Object -First 1
    if ("$lockPid" -match '^\d+$' -and (Get-Process -Id ([int]$lockPid) -ErrorAction SilentlyContinue)) {
        return [int]$lockPid
    }
    return $null
}

function Get-RunStates {
    # Every run in the log, oldest first, with its state:
    #   finished    - run.end recorded
    #   running     - the newest unfinished run, while a live process holds the lock
    #   interrupted - unfinished and nobody holds the lock (crash, kill, reboot)
    param(
        [object[]]$Events = @(),
        [string]$LockPath
    )
    $starts = @($Events | Where-Object { $_.type -eq 'run.begin' })
    $ends = @{}
    foreach ($e in @($Events | Where-Object { $_.type -eq 'run.end' })) { $ends[[string]$e.runId] = $e }
    $holder = Get-LockHolder -LockPath $LockPath
    $out = @()
    for ($i = 0; $i -lt $starts.Count; $i++) {
        $s = $starts[$i]
        $id = [string]$s.runId
        $end = if ($ends.ContainsKey($id)) { $ends[$id] } else { $null }
        $state = if ($end) { 'finished' } elseif ($i -eq $starts.Count - 1 -and $holder) { 'running' } else { 'interrupted' }
        $out += [pscustomobject]@{
            RunId   = $id
            Start   = $s.ts
            End     = if ($end) { $end.ts } else { $null }
            State   = $state
            Pid     = if ($state -eq 'running') { $holder } else { $null }
            Summary = if ($end -and (Test-HasProp $end 'summary')) { $end.summary } else { $null }
        }
    }
    return $out
}

function Resolve-RunRef {
    # Pick one run by reference: 'latest' (or empty), a full run id, or any unique
    # ending of one (e.g. '332d'). Throws when nothing or several runs match.
    param(
        [object[]]$Runs = @(),
        [string]$Ref
    )
    if ($Runs.Count -eq 0) { throw 'no runs recorded yet' }
    if (-not $Ref -or $Ref -eq 'latest') { return $Runs[-1] }
    $exact = @($Runs | Where-Object { $_.RunId -eq $Ref })
    if ($exact.Count -eq 1) { return $exact[0] }
    $hits = @($Runs | Where-Object { $_.RunId.EndsWith($Ref, [System.StringComparison]::OrdinalIgnoreCase) })
    if ($hits.Count -eq 1) { return $hits[0] }
    if ($hits.Count -eq 0) { throw "no run matches '$Ref'" }
    throw "'$Ref' matches several runs: $(($hits | ForEach-Object { $_.RunId }) -join ', ')"
}

function Get-RunDetail {
    # Per-service view of one run, folded from its events: steps with durations, the
    # step in progress (or the one a dead run stopped in), outcome, size, archive id.
    param(
        [object[]]$Events = @(),
        [Parameter(Mandatory)]$Run
    )
    $runEvents = @($Events | Where-Object { (Test-HasProp $_ 'runId') -and [string]$_.runId -eq $Run.RunId })
    $order = @()
    $planEvent = $runEvents | Where-Object { $_.type -eq 'run.plan' } | Select-Object -First 1
    if ($planEvent -and (Test-HasProp $planEvent 'plan')) { $order = @($planEvent.plan | ForEach-Object { [string]$_ }) }

    $services = [ordered]@{}
    $get = {
        param($name)
        if (-not $services.Contains($name)) {
            $services[$name] = [pscustomobject]@{
                Service = $name; Steps = [System.Collections.Generic.List[object]]::new(); Open = $null
                Status = $null; Reason = $null; Problems = @(); Error = $null; Bytes = $null
                Snapshot = $null; Tier = $null; SyncFail = $null; Started = $false
                Warnings = [System.Collections.Generic.List[string]]::new()
                Moved = [System.Collections.Generic.List[string]]::new()   # unusual moves to trash
            }
        }
        $services[$name]
    }
    foreach ($name in $order) { $null = & $get $name }
    $deletions = [System.Collections.Generic.List[object]]::new()
    $notify = $null
    $held = $null   # trash items left for `bseq trash -Delete` at this run's end (emptyTrash manual)
    $short = { param($id) $x = [string]$id; $x.Substring([math]::Max(0, $x.Length - 4)) }

    foreach ($e in $runEvents) {
        if ($e.type -eq 'notify.send') {
            $notify = [pscustomobject]@{ Ok = ($e.status -eq 'ok'); Error = $(if (Test-HasProp $e 'error') { [string]$e.error } else { $null }) }
            continue
        }
        # trash deletions go to the run's deletions block, not to a service row: an
        # item deleted now may belong to a service this run never touches
        if ($e.type -eq 'trash.delete') {
            $ok = $e.status -eq 'ok'
            $origin = if (Test-HasProp $e 'reason') { "{0}, run {1}" -f $e.reason, (& $short $e.fromRun) } else { "no record: $($e.trashName)" }
            $deletions.Add([pscustomobject]@{ Kind = 'delete'; Service = $(if (Test-HasProp $e 'svc') { [string]$e.svc } else { '(no record)' })
                    Ok = $ok; Bytes = [double]$e.bytes; Files = [int]$e.files
                    Detail = $(if ($ok) { $origin } else { "kept: $($e.trashName): $($e.error)" }) })
            continue
        }
        if ($e.type -eq 'trash.hold') {
            $deletions.Add([pscustomobject]@{ Kind = 'held'; Service = [string]$e.svc; Ok = $true
                    Bytes = [double]$e.bytes; Files = [int]$e.files; Detail = "emptyTrash manual: bseq trash -Delete $($e.trashName)" })
            continue
        }
        if ($e.type -eq 'run.end' -and (Test-HasProp $e 'trashHeld')) {
            $held = [pscustomobject]@{ Items = [int]$e.trashHeld.items; Bytes = [double]$e.trashHeld.bytes }
            continue
        }
        if (-not (Test-HasProp $e 'svc')) { continue }
        if ($e.type -eq 'trash.move') {
            if ($e.status -ne 'ok') { $svcM = & $get ([string]$e.svc); $svcM.Warnings.Add("move to trash failed ($($e.reason)): $($e.error)") }
            elseif ($e.reason -ne 'local-copy-dropped') { $svcM = & $get ([string]$e.svc); $svcM.Moved.Add([string]$e.reason) }
            continue
        }
        if ($e.type -eq 'service.archive-pruned') {
            $deletions.Add([pscustomobject]@{ Kind = 'prune'; Service = [string]$e.svc; Ok = $true
                    Bytes = $(if (Test-HasProp $e 'bytes') { [double]$e.bytes } else { 0 }); Files = $(if (Test-HasProp $e 'files') { [int]$e.files } else { 0 })
                    Detail = [string]$e.path })
        }
        if ($e.type -eq 'service.archive-prunefail') {
            $deletions.Add([pscustomobject]@{ Kind = 'prune'; Service = [string]$e.svc; Ok = $false; Bytes = 0; Files = 0
                    Detail = "kept: $($e.path): $($e.error)" })
        }
        $svc = & $get ([string]$e.svc)
        switch ($e.type) {
            'service.begin' { $svc.Started = $true }
            'step.begin' { $svc.Open = [pscustomobject]@{ Step = [string]$e.step; Start = $e.ts } }
            'step.end' {
                $svc.Steps.Add([pscustomobject]@{ Step = [string]$e.step; Status = [string]$e.status; DurationSec = [double]$e.durationSec })
                $svc.Open = $null
                if (Test-HasProp $e 'warnings') { foreach ($w in @($e.warnings)) { $svc.Warnings.Add("$($e.step): $w") } }
            }
            'service.skip' {
                $svc.Status = 'skipped'; $svc.Reason = [string]$e.reason
                if ($svc.Reason -eq 'insufficient-space' -and (Test-HasProp $e 'needBytes') -and (Test-HasProp $e 'freeBytes')) {
                    # events before the headroom settings carry no formula terms
                    $needText = if ((Test-HasProp $e 'lastBytes') -and (Test-HasProp $e 'ratio') -and (Test-HasProp $e 'marginBytes')) {
                        Format-SpaceNeed ([double]$e.needBytes) ([double]$e.lastBytes) ([double]$e.ratio) ([double]$e.marginBytes)
                    }
                    else { Format-Size ([double]$e.needBytes) }
                    $svc.Warnings.Add(("insufficient space in the spool (need {0}, free {1})" -f $needText, (Format-Size ([double]$e.freeBytes))))
                }
            }
            'service.replaced' { $svc.Warnings.Add('replaced the previous backup in ready/, never taken by the archiver') }
            'service.archived' {
                if (Test-HasProp $e 'snapshot') { $svc.Snapshot = [string]$e.snapshot }
                if (Test-HasProp $e 'tier') { $svc.Tier = [string]$e.tier }
            }
            'service.syncfail' { $svc.SyncFail = if (Test-HasProp $e 'reason') { [string]$e.reason } else { 'see events.jsonl' } }
            'service.end' {
                $svc.Status = [string]$e.status
                if (Test-HasProp $e 'bytes') { $svc.Bytes = [double]$e.bytes }
                if (Test-HasProp $e 'reason') { $svc.Reason = [string]$e.reason }
                if (Test-HasProp $e 'problems') { $svc.Problems = @($e.problems) }
                if (Test-HasProp $e 'error') { $svc.Error = [string]$e.error }
            }
        }
    }
    return [pscustomobject]@{ Run = $Run; Services = @($services.Values); Deletions = @($deletions); Notify = $notify; Held = $held }
}

function Format-DeletionTotals {
    # "freed 47.1 GB in 3 items, pruned 1 archive (1.2 GB); 2 failed"
    param([object[]]$Deletions = @())
    $parts = @()
    $del = @($Deletions | Where-Object { $_.Kind -eq 'delete' -and $_.Ok })
    $pr = @($Deletions | Where-Object { $_.Kind -eq 'prune' -and $_.Ok })
    $hd = @($Deletions | Where-Object { $_.Kind -eq 'held' })
    $failed = @($Deletions | Where-Object { -not $_.Ok }).Count
    $sumOf = { param($xs) $t = 0.0; foreach ($x in $xs) { $t += $x.Bytes }; $t }
    if ($del.Count) { $parts += "freed {0} in {1} item{2}" -f (Format-Size (& $sumOf $del)), $del.Count, $(if ($del.Count -gt 1) { 's' } else { '' }) }
    if ($pr.Count) { $parts += "pruned {0} archive{1} ({2})" -f $pr.Count, $(if ($pr.Count -gt 1) { 's' } else { '' }), (Format-Size (& $sumOf $pr)) }
    if ($hd.Count) { $parts += "held {0} in {1} item{2}" -f (Format-Size (& $sumOf $hd)), $hd.Count, $(if ($hd.Count -gt 1) { 's' } else { '' }) }
    $text = $parts -join ', '
    if ($failed) { $text = ($text + "; $failed failed").TrimStart(';', ' ') }
    return $text
}

function Format-RunDetail {
    # Render Get-RunDetail as text lines (status / show). $Now drives elapsed times.
    param(
        [Parameter(Mandatory)]$Detail,
        [datetime]$Now = (Get-Date),
        [string]$Prefix = ''
    )
    $run = $Detail.Run
    $since = { param($ts) Format-Duration (($Now.ToUniversalTime() - ([datetime]$ts).ToUniversalTime()).TotalSeconds) }
    $lines = @()
    switch ($run.State) {
        'running' {
            $lines += ("{0}RUNNING  run {1}  since {2} ({3})  pid {4}" -f $Prefix, $run.RunId, (Format-EventTime $run.Start), (& $since $run.Start), $run.Pid)
        }
        'interrupted' {
            $lines += ("{0}INTERRUPTED  run {1}  started {2}; no end recorded and no process holds the lock" -f $Prefix, $run.RunId, (Format-EventTime $run.Start))
        }
        default {
            $dur = Format-Duration ((([datetime]$run.End).ToUniversalTime() - ([datetime]$run.Start).ToUniversalTime()).TotalSeconds)
            $sum = if ($run.Summary) { "  ok={0} failed={1} planned={2}" -f $run.Summary.ok, $run.Summary.failed, $run.Summary.planned } else { '' }
            $lines += ("{0}run {1}  {2} -> {3} ({4}){5}" -f $Prefix, $run.RunId, (Format-EventTime $run.Start), (Format-EventTime $run.End), $dur, $sum)
        }
    }

    foreach ($s in $Detail.Services) {
        $steps = (@($s.Steps | ForEach-Object {
                    $mark = if ($_.Status -eq 'ok') { '' } else { ' ' + $_.Status.ToUpper() }
                    "{0}{1} {2}" -f $_.Step, $mark, (Format-Duration $_.DurationSec)
                }) -join ', ')
        $size = if ($null -ne $s.Bytes -and $s.Bytes -gt 0) { Format-Size $s.Bytes } else { '' }
        $archive = if ($s.Snapshot) { 'snap ' + $s.Snapshot.Substring(0, [math]::Min(8, $s.Snapshot.Length)) } elseif ($s.Tier) { $s.Tier } else { '' }
        $note = $null

        if ($s.Open) {
            if ($run.State -eq 'running') {
                $status = "> $($s.Open.Step) ($(& $since $s.Open.Start))"
            }
            else {
                $status = "! died in $($s.Open.Step)"
                $note = 'check this service: a backup stopped mid-step may have left it down'
            }
        }
        elseif ($s.Started -and -not $s.Status) {
            # begun, but no step open: between two steps, or in the engine's own work
            if ($run.State -eq 'running') { $status = '> between steps' }
            else {
                $status = '! died between steps'
                $note = 'check this service: a backup stopped mid-way may have left it down'
            }
        }
        elseif ($s.Status -eq 'skipped') { $status = "skipped ($($s.Reason))" }
        elseif ($s.Status -eq 'fail' -and $s.Reason -eq 'invalid') { $status = 'INVALID' }
        elseif ($s.Status -eq 'fail') { $status = 'FAIL' }
        elseif ($s.Status) { $status = $s.Status }
        elseif ($run.State -eq 'running') { $status = 'pending' }
        else { $status = 'not reached' }

        $lines += ("  {0,-22} {1,-20} {2,9}  {3,-14} {4}" -f $s.Service, $status, $size, $archive, $steps).TrimEnd()
        foreach ($p in $s.Problems) { $lines += "      - $p" }
        if ($s.Error) { $lines += "      ! $($s.Error)" }
        if ($s.SyncFail) { $lines += "      ! archive failed: $($s.SyncFail)" }
        foreach ($w in $s.Warnings) { $lines += "      ! $w" }
        if ($s.Moved.Count) { $lines += "      moved to trash: $($s.Moved -join ', ')" }
        if ($note) { $lines += "      ! $note" }
    }
    if ($Detail.Services.Count -eq 0) { $lines += '  (no services)' }
    if ((Test-HasProp $Detail 'Notify') -and $Detail.Notify) {
        $lines += ("  {0,-22} {1}" -f 'report mail', $(if ($Detail.Notify.Ok) { 'sent' } else { 'FAIL' }))
        if (-not $Detail.Notify.Ok) { $lines += "      ! $($Detail.Notify.Error)" }
    }
    if (@($Detail.Deletions).Count) {
        $lines += ("  {0,-22} {1}" -f 'deletions', (Format-DeletionTotals $Detail.Deletions))
        foreach ($d in $Detail.Deletions) {
            $mark = if ($d.Ok) { '      ' } else { '    ! ' }
            if ($d.Ok) {
                $lines += ("{0}{1,-7} {2,-16} {3,9} {4,7} files  {5}" -f $mark, $d.Kind, $d.Service, (Format-Size $d.Bytes), $d.Files, $d.Detail)
            }
            else {
                $lines += ("{0}{1,-7} {2,-16} {3}" -f $mark, $d.Kind, $d.Service, $d.Detail)
            }
        }
    }
    if ((Test-HasProp $Detail 'Held') -and $Detail.Held) {
        $lines += ("  {0,-22} {1} item{2}, {3} (emptyTrash manual: bseq trash)" -f 'trash held', $Detail.Held.Items,
            $(if ($Detail.Held.Items -gt 1) { 's' } else { '' }), (Format-Size $Detail.Held.Bytes))
    }
    return $lines
}

function Format-RunHistoryLine {
    # One history line per run: finished runs as before, plus RUNNING / INTERRUPTED.
    param(
        [Parameter(Mandatory)]$Detail,
        [datetime]$Now = (Get-Date)
    )
    $run = $Detail.Run
    $svcs = @($Detail.Services | ForEach-Object {
            if ($_.Open) { "{0}:{1}..." -f $_.Service, $_.Open.Step }
            elseif ($_.Started -and -not $_.Status) { "{0}:..." -f $_.Service }
            elseif ($_.Status) { "{0}:{1}" -f $_.Service, $(if ($_.Status -eq 'skipped') { $_.Reason } else { $_.Status }) }
        } | Where-Object { $_ })
    $svcStr = if ($svcs.Count) { $svcs -join ' ' } else { '(nothing run)' }
    $mail = if ((Test-HasProp $Detail 'Notify') -and $Detail.Notify -and -not $Detail.Notify.Ok) { '  mail:FAIL' } else { '' }
    switch ($run.State) {
        'running' {
            return ("{0}  {1}  RUNNING ({2})  [{3}]" -f (Format-EventTime $run.Start), $run.RunId, (Format-Duration (($Now.ToUniversalTime() - ([datetime]$run.Start).ToUniversalTime()).TotalSeconds)), $svcStr)
        }
        'interrupted' { return ("{0}  {1}  INTERRUPTED  [{2}]" -f (Format-EventTime $run.Start), $run.RunId, $svcStr) }
        default {
            $sum = $run.Summary
            return ("{0}  {1}  ok={2} failed={3} planned={4}  [{5}]{6}" -f (Format-EventTime $run.End), $run.RunId, $sum.ok, $sum.failed, $sum.planned, $svcStr, $mail)
        }
    }
}

