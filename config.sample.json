{
  "window": { "open": "23:00", "close": "06:00" },
  "spool": "/var/spool/backup-sequencer",
  "resources": { "diskA": 1, "diskB": 1, "net-out": 1, "cpu": 2 },
  "archive": { "ARCHIVE_DEST": "/var/backups/cloud" },
  "notify": {
    "enabled": false,
    "from": "backups@example.com",
    "to": ["ops@example.com"],
    "server": "smtp.example.com:587",
    "authUser": "smtp-user",
    "passwordFile": "secrets/smtp.pass"
  },
  "services": {
    "example-app": {
      "enabled": true,
      "mandatory": true,
      "class": "triggered",
      "script": "recipes/docker-compose-cold.ps1",
      "env": {
        "DCC_COMPOSE_DIR": "/srv/example-app",
        "DCC_DATA_DIR": "/srv/example-app/data",
        "DCC_COMPOSE_CMD": "docker compose",
        "DCC_ARCHIVE_NAME": "example-app_data.tar"
      },
      "publishToReady": true,
      "syncArchive": {
        "script": "recipes/archive-copy.ps1",
        "env": { "ARCHIVE_KEEP": "7" }
      },
      "steps": [
        { "name": "stop", "resources": [] },
        { "name": "dump", "resources": ["diskA"], "timeoutSec": 1800 },
        { "name": "start", "resources": [], "alwaysRun": true }
      ]
    }
  }
}
